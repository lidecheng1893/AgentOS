# 版本字段比较（点分数字 + 字母补丁后缀，如 5 vs 5a：空后缀 < 字母后缀
# < b < ...，即 0.1.5 < 0.1.5a < 0.1.5b）：输出 -1|0|1
# 2026-08-29 修复：v0.1.5a 字母后缀曾触发 bash 算术错误
# （"5a: value too great for base"）导致 ver_cmp 误判相等，0.1.5 用户
# 无法自动升级到 0.1.5a。数字部分强制 10# 十进制（防前导零）。
# 0.1.6h 修复：剥除字段首字母前缀（如双 v 产生的 "v0"），杜绝
# "10#v0: value too great for base" 静默判等。
field_cmp() {
    local x="$1" y="$2" xn="" yn="" xl="" yl=""
    while [ -n "$x" ] && [[ "$x" == [a-zA-Z]* ]]; do x="${x#?}"; done
    while [ -n "$y" ] && [[ "$y" == [a-zA-Z]* ]]; do y="${y#?}"; done
    xn="${x%%[a-zA-Z]*}"; xl="${x#$xn}"
    yn="${y%%[a-zA-Z]*}"; yl="${y#$yn}"
    xn="${xn:-0}"; yn="${yn:-0}"
    if (( 10#$xn > 10#$yn )); then echo 1; return; fi
    if (( 10#$xn < 10#$yn )); then echo -1; return; fi
    if [ -z "$xl" ] && [ -z "$yl" ]; then echo 0; return; fi
    if [ -z "$xl" ]; then echo -1; return; fi   # 5 < 5a
    if [ -z "$yl" ]; then echo 1; return; fi    # 5a > 5
    if [[ "$xl" < "$yl" ]]; then echo -1; return; fi
    if [[ "$xl" > "$yl" ]]; then echo 1; return; fi
    echo 0
}

# 版本比较（SemVer 简化：点分字段 + -alpha/-beta/-rc 后缀）：输出 -1|0|1
ver_cmp() { # <a> <b>
    local a="$1" b="$2" apr="" bpr=""
    a="${a#v}"; b="${b#v}"
    case "$a" in *-*) apr="${a#*-}"; a="${a%%-*}";; esac
    case "$b" in *-*) bpr="${b#*-}"; b="${b%%-*}";; esac
    local -a av bv
    IFS='.' read -r -a av <<< "$a"
    IFS='.' read -r -a bv <<< "$b"
    local n=$(( ${#av[@]} > ${#bv[@]} ? ${#av[@]} : ${#bv[@]} )) i c
    for ((i=0; i<n; i++)); do
        c="$(field_cmp "${av[$i]:-0}" "${bv[$i]:-0}")"
        if [ "$c" = "1" ]; then echo 1; return; fi
        if [ "$c" = "-1" ]; then echo -1; return; fi
    done
    if [ -z "$apr" ] && [ -z "$bpr" ]; then echo 0; return; fi
    if [ -z "$apr" ]; then echo 1; return; fi   # 正式版 > prerelease
    if [ -z "$bpr" ]; then echo -1; return; fi
    # 0.1.7 修复：prerelease 先按类型优先级比较（alpha < beta < rc），
    # 类型相同再比数字段——此前只取最后一个点分段数字比较，
    # -beta.5 与 -rc.2 会被误判 5 > 2（rc 应更新于 beta）。
    local pa pb
    case "$apr" in alpha*) pa=1;; beta*) pa=2;; rc*) pa=3;; *) pa=4;; esac
    case "$bpr" in alpha*) pb=1;; beta*) pb=2;; rc*) pb=3;; *) pb=4;; esac
    if (( pa > pb )); then echo 1; return; fi
    if (( pa < pb )); then echo -1; return; fi
    # 同类型：数字段比较（beta.1/rc.2）；无点分段（beta）视为 .0
    local an bn
    an="${apr##*.}"; [ "$an" = "$apr" ] && an="0"
    bn="${bpr##*.}"; [ "$bn" = "$bpr" ] && bn="0"
    echo "$(field_cmp "$an" "$bn")"
}

# 当前平台键（manifest artifacts 键名，与打包命名对齐）：linux-x86-64 /
# macos-arm-64 等。制品平台命名规范（0.1.10 起，用户定案）：
# OS-架构族-位宽，弃用 i686/armv7l/x64/arm64 等架构行话。与 install.sh
# plat_name、build.sh PLATFORM 映射同口径。
plat_name() {
    case "$1" in
        x86_64)  echo "x86-64" ;;
        i686)    echo "x86-32" ;;
        aarch64) echo "arm-64" ;;
        armv7l)  echo "arm-32" ;;
        riscv64) echo "riscv-64" ;;
        riscv32) echo "riscv-32" ;;
        *)       echo "$1" ;;
    esac
}

# 平台键兼容反查（三代 manifest）：本版主键 = OS-架构族-位宽（gen3）；
# 旧两代依次回退：gen2（0.1.6e~0.1.10：linux-x64/x86/arm64/arm32…）→
# gen1（≤0.1.6d：uname 原始名 linux-x86_64/i686/aarch64/armv7l…）。
# 与发布侧 publish-release.sh ALIAS 表同口径（SSoT）。
plat_legacy_name() {
    case "$1" in
        linux-x86-64|macos-x86-64|win-x86-64) printf '%s\n' "${1%-x86-64}-x64" "${1%-x86-64}-x86_64" ;;
        linux-x86-32|macos-x86-32|win-x86-32) printf '%s\n' "${1%-x86-32}-x86" "${1%-x86-32}-i686" ;;
        linux-arm-64|macos-arm-64|win-arm-64) printf '%s\n' "${1%-arm-64}-arm64" "${1%-arm-64}-aarch64" ;;
        linux-arm-32|macos-arm-32|win-arm-32) printf '%s\n' "${1%-arm-32}-arm32" "${1%-arm-32}-armv7l" ;;
        linux-riscv-64|win-riscv-64)          echo "${1%-riscv-64}-riscv64" ;;
        linux-riscv-32|win-riscv-32)          echo "${1%-riscv-32}-riscv32" ;;
        *)                                    echo "" ;;
    esac
}

# 某技术架构允许的包内 platform-* 标记（三代全兼容：新更新器处理存量
# gen2/gen1 离线包不误拒）。与 install.sh plat_markers、CI 打包标记同口径。
plat_markers() {
    case "$1" in
        x86_64)  printf 'platform-x86-64 platform-x64 platform-x86_64 platform-amd64' ;;
        i686)    printf 'platform-x86-32 platform-x86 platform-i686 platform-i386' ;;
        aarch64) printf 'platform-arm-64 platform-arm64 platform-aarch64' ;;
        armv7l)  printf 'platform-arm-32 platform-arm32 platform-armv7l' ;;
        riscv64) printf 'platform-riscv-64 platform-riscv64' ;;
        riscv32) printf 'platform-riscv-32 platform-riscv32' ;;
        *)       echo "" ;;
    esac
}

runtime_platform() {
    local os arch
    case "$(uname -s 2>/dev/null)" in
        Darwin) os="macos"; arch="$(uname -m 2>/dev/null)" ;;   # arm64 / x86_64
        *)      os="linux"; arch="$(detect_arch)" ;;
    esac
    echo "${os}-$(plat_name "${arch}")"
}

# manifest 字段提取（python3 优先，回退 grep 顶层键）
manifest_get() { # <manifest> <latest|artifact:<platform>>
    local f="$1" mode="$2"
    if command -v python3 >/dev/null 2>&1; then
        python3 - "$f" "$mode" <<'PYEOF'
import json, sys
try:
    m = json.load(open(sys.argv[1]))
except Exception:
    sys.exit(1)
mode = sys.argv[2]
if mode == "latest":
    print(m.get("latest", ""))
elif mode.startswith("artifact:"):
    plat = mode.split(":", 1)[1]
    rel = m.get("releases", {}).get(m.get("latest", ""), {})
    art = rel.get("artifacts", {}).get(plat, {})
    print(art.get("url", ""))
    print(art.get("sha256", ""))
PYEOF
        return 0
    fi
    # 回退：仅顶层 latest / 单行 artifact 提取
    case "$mode" in
        latest) sed -n 's/.*"latest"[[:space:]]*:[[:space:]]*"\([^"]*\)".*/\1/p' "$f" | head -1 ;;
        artifact:*) : ;;
    esac
}

# AtomGit raw 域（raw.atomgit.com/.../raw/...）对非 Markdown 文件返回
# HTML 预览页（"暂不支持预览"，403），不可作原始文件直链。改用 v5
# contents API：匿名 GET /repos/{owner}/{repo}/contents/<path>?ref=main
# 返回 JSON（content 为 base64），python3 解码优先，无 python3 时回退
# sed 提取 + base64 -d（content 为单行 base64，不含引号，提取安全）。
fetch_repo_file() { # <repo_path> <dest>
    local api="https://api.atomgit.com/api/v5/repos/${AIRY_RELEASE_OWNER:-openairymax/agentrt}/contents/$1?ref=main"
    local tmp="$AIRY_HOME/tmp/contents.$$"
    mkdir -p "$(dirname "$tmp")" 2>/dev/null
    syscurl -fsSL --max-time 60 -o "$tmp" "$api" || { rm -f "$tmp"; return 1; }
    if command -v python3 >/dev/null 2>&1; then
        python3 -c 'import json,sys,base64; sys.stdout.buffer.write(base64.b64decode(json.load(sys.stdin).get("content","").replace("\n","")))' < "$tmp" > "$2" || { rm -f "$tmp"; return 1; }
    else
        sed -n 's/.*"content"[[:space:]]*:[[:space:]]*"\([^"]*\)".*/\1/p' "$tmp" | tr -d '\n' | base64 -d > "$2" 2>/dev/null || { rm -f "$tmp"; return 1; }
    fi
    rm -f "$tmp"
    [ -s "$2" ]
}

# GPG 验签（独立 homedir，不污染用户 keyring；签名缺失拒绝——fail-closed
# 防供应链攻击。公钥优先级：发布源 latest/keys/ 在线拉取（支持轮换）→
# 本地 $AIRY_HOME/keys/ → 内置公钥（首次引导兜底））。
verify_gpg_sig() { # <file> <sig.asc>
    local f="$1" sig="$2"
    [ -s "$sig" ] || { log warn "缺少签名文件（fail-closed），拒绝更新"; return 1; }
    local GNUPG="$AIRY_HOME/tmp/gnupg-update"
    mkdir -p "$GNUPG"
    chmod 700 "$GNUPG"
    local KEYF="$GNUPG/agentrt.asc"
    if [ -z "${AIRY_NO_NETWORK:-}" ]; then
        fetch_repo_file "latest/keys/agentrt.asc" "$KEYF" >/dev/null 2>&1 || true
    fi
    if [ ! -s "$KEYF" ] && [ -f "$AIRY_HOME/keys/agentrt.asc" ]; then
        cp -f "$AIRY_HOME/keys/agentrt.asc" "$KEYF" 2>/dev/null || true
    fi
    [ -s "$KEYF" ] || printf '%s\n' "$AIRY_GPG_PUBKEY" > "$KEYF"
    gpg --batch --quiet --no-tty --homedir "$GNUPG" --import "$KEYF" >/dev/null 2>&1 || return 1
    gpg --batch --no-tty --homedir "$GNUPG" --verify "$sig" "$f" >/dev/null 2>&1
}

# 替换包体：sha256 强制校验 → 备份 → 热替换 → 自检 → 失败自动回滚 →
# 更新 install.env。期望校验值由调用方传入（manifest 或 --sha256/相邻 .sha256），
# 缺期望值直接拒绝（问题 12：离线包/远程包统一防绕过验签口径）。
apply_package() { # <tarball> [expect_sha]
    local tarball="$1" expect_sha="$2" arch="$(detect_arch)"
    local TMPD="$AIRY_HOME/tmp/apply.$$"
    rm -rf "$TMPD"; mkdir -p "$TMPD"
    # sha256 强制校验（fail-closed）
    if [ -n "$expect_sha" ]; then
        if ! echo "${expect_sha}  ${tarball}" | sha256sum -c - >/dev/null 2>&1; then
            log error "sha256 校验失败，拒绝安装"; rm -rf "$TMPD"; return 1
        fi
        log ok "sha256 校验通过"
    else
        log error "缺少 sha256 期望值，拒绝安装（防供应链绕过）"; rm -rf "$TMPD"; return 1
    fi
    # 架构自检（同 install.sh install_binary 口径）：三代 platform-* 标记
    # 兼容——本版标记 platform-<架构族-位宽>（如 platform-x86-64），存量
    # gen2/gen1 标记（platform-x64 / platform-x86_64 等）同放行；异架构
    # 标记明确拒绝。
    _am_marker="$(tar -tzf "$tarball" 2>/dev/null | grep -oE 'platform-[A-Za-z0-9_-]+' | head -1 || true)"
    if [ -n "$_am_marker" ]; then
        _am_ok=""
        for _am_p in $(plat_markers "$arch"); do
            [ "$_am_marker" = "$_am_p" ] && { _am_ok=1; break; }
        done
        if [ -z "$_am_ok" ]; then
            log error "制品架构与当前主机（${arch}）不匹配（标记 ${_am_marker}），拒绝更新"
            rm -rf "$TMPD"; return 1
        fi
        log info "架构校验通过（${arch}）"
    fi
    tar -xzf "$tarball" -C "$TMPD" || { log error "解压失败"; rm -rf "$TMPD"; return 1; }
    local extracted="$(find "$TMPD" -maxdepth 1 -type d -name 'agentrt-*' | head -1)"
    [ -n "$extracted" ] || { log error "包结构异常（缺 agentrt-* 顶层目录）"; rm -rf "$TMPD"; return 1; }
    local new_ver="$(basename "$extracted" | sed -e 's/^agentrt-//' -e 's/^v//')"
    # 备份当前版本
    local cur_ver="$(sed -n 's/^AIRY_VERSION=//p' "$AIRY_HOME/config/install.env" 2>/dev/null | head -1)"
    # 0.1.6h 修复：备份目录带时间戳——同版本重复更新会覆盖上次备份，
    # 回滚失去意义；保留最近 3 份（尾部清理逻辑已在）。
    local bkup="$AIRY_HOME/.rollback/${cur_ver:-pre-update}-$(date +%Y%m%d%H%M%S)"
    rm -rf "$bkup"; mkdir -p "$bkup"
    for d in bin lib include share; do
        [ -d "$AIRY_HOME/$d" ] && cp -r "$AIRY_HOME/$d" "$bkup/" 2>/dev/null || true
    done
    log info "已备份当前版本: .rollback/（${cur_ver:-pre-update}）"
    # 热替换（保留 config 用户配置/data/run/logs）
    [ -d "$extracted/bin" ]     && cp -f "$extracted"/bin/*     "$AIRY_HOME/bin/"    2>/dev/null || true
    [ -d "$extracted/lib" ]     && cp -f "$extracted"/lib/*     "$AIRY_HOME/lib/"    2>/dev/null || true
    [ -d "$extracted/include" ] && cp -rf "$extracted"/include/* "$AIRY_HOME/include/" 2>/dev/null || true
    [ -d "$extracted/share" ]   && cp -rf "$extracted"/share/*   "$AIRY_HOME/share/"   2>/dev/null || true
    if [ -d "$extracted/config" ]; then
        for f in "$extracted"/config/*; do
            [ -f "$f" ] || continue
            b="$(basename "$f")"
            case "$b" in
                secrets.env) continue ;;   # 用户敏感配置绝不覆盖
                *) [ -f "$AIRY_HOME/config/$b" ] || cp -f "$f" "$AIRY_HOME/config/" 2>/dev/null || true ;;
            esac
        done
    fi
    # 同步签名公钥（新包自带时）
    [ -f "$extracted/keys/agentrt.asc" ] && cp -f "$extracted/keys/agentrt.asc" "$AIRY_HOME/keys/" 2>/dev/null || true
    # 0.1.6h 修复：清理旧版本独有文件（"更新没覆盖旧制品"根因）。
    # 热替换只 cp -f 覆盖同名文件，旧版本独有 bin/*_d 等全部残留，
    # 启动器按 bin/*_d 自动推导会把残留旧 daemon 一并拉起。
    # 0.1.6h 补充修复：入口/环境生成文件（由安装器/更新器生成、包内
    # 不含）必须排除清理——否则更新后 bin/airymaxrt 与 agentrt-env.sh
    # 被误删，airymaxrt 命令直接失效（软链悬空），daemon 传递依赖
    # 也无法解析。
    for d in bin lib include share; do
        [ -d "$AIRY_HOME/$d" ] && [ -d "$extracted/$d" ] || continue
        for f in "$AIRY_HOME/$d"/*; do
            [ -f "$f" ] || continue
            case "$(basename "$f")" in
                airymaxrt|airymaxrt-full|agentrt-env.sh) continue ;;
            esac
            [ -e "$extracted/$d/$(basename "$f")" ] || rm -f "$f"
        done
    done
    # 自检：关键二进制存在（防止不完整包静默替换导致 daemon 群起不来）
    if [ ! -x "$AIRY_HOME/bin/airy_cli" ] || [ ! -x "$AIRY_HOME/bin/agentrt-bootstrap.sh" ]; then
        log error "热替换自检失败（bin/ 关键组件缺失），自动回滚…"
        for d in bin lib include share; do
            [ -d "$bkup/$d" ] && cp -rf "$bkup/$d"/* "$AIRY_HOME/$d/" 2>/dev/null || true
        done
        rm -rf "$TMPD"
        return 1
    fi
    # 固化新版本到 install.env（sed_inplace 跨平台：macOS BSD sed 直接
    # 覆盖会失败，导致 AIRY_VERSION 键重复/不更新）
    if [ -f "$AIRY_HOME/config/install.env" ]; then
        sed_inplace "s|^AIRY_VERSION=.*|AIRY_VERSION=v${new_ver}|" "$AIRY_HOME/config/install.env" || \
            printf 'AIRY_VERSION=v%s\n' "$new_ver" >> "$AIRY_HOME/config/install.env"
    fi
    rm -rf "$TMPD"
    # 0.1.6c 系统性修复：热替换后自愈 agentrt-env.sh。老用户（0.1.5a 及
    # 更早安装）的 env.sh 无 LD_LIBRARY_PATH 注入行，而 apply_package 只
    # 热替换 bin/lib/include/share/config，不重新生成 env.sh——升级后
    # daemon 传递依赖（libcurl→libssl.so.1.1 等）仍无法解析（"很多库
    # 找不到"，Ubuntu 24.04 无 libssl.so.1.1）。幂等补写：env.sh 缺失
    # LD_LIBRARY_PATH 行时追加，不覆盖用户已有注入。
    if [ -f "$AIRY_HOME/bin/agentrt-env.sh" ] \
       && ! grep -q 'LD_LIBRARY_PATH' "$AIRY_HOME/bin/agentrt-env.sh" 2>/dev/null; then
        printf '\nexport LD_LIBRARY_PATH="${AIRY_HOME}/lib:${LD_LIBRARY_PATH:-}"\n' \
            >> "$AIRY_HOME/bin/agentrt-env.sh"
        chmod 700 "$AIRY_HOME/bin/agentrt-env.sh" 2>/dev/null || true
        log info "agentrt-env.sh 已补写 LD_LIBRARY_PATH 注入（0.1.6c 自愈）"
    fi
    # 0.1.6a 修复：更新后重生成入口启动器。apply_package 仅热替换 bin/，
    # 而轻量启动器（$AIRY_HOME/bin/airymaxrt）模板内嵌于 install.sh，
    # 不会被更新刷新——旧轻量启动器无参数直通前端、daemon 群未拉起
    # （社区"online 0/17"）。以完整启动器自身覆盖入口：其默认流程先确保
    # 守护进程群就绪再进前端（与 start/无参数语义一致），且离线可用、
    # 不依赖网络。远程通道与本地离线包（--file）两条更新路径均经此。
    local _entry="$AIRY_HOME/bin/airymaxrt"
    if [ -s "$_SOURCE" ] && [ "$_SOURCE" != "$(readlink -f "$_entry" 2>/dev/null || echo "$_entry")" ]; then
        if cp -f "$_SOURCE" "$_entry" 2>/dev/null && chmod 755 "$_entry"; then
            log info "入口启动器已重生成（no-args 将自动拉起守护进程群）"
        else
            log warn "入口启动器重生成失败（可运行 airymaxrt start 或重装修复）"
        fi
    elif [ ! -x "$_entry" ] && [ -s "$bkup/bin/airymaxrt" ]; then
        # 0.1.6h 补充修复：入口源不可用（自举源 airymaxrt-full 已被清理
        # 逻辑误删等历史场景）时从备份恢复旧入口，保证 airymaxrt 命令
        # 始终可用；恢复后仍可再次 update 自举完整启动器。
        if cp -f "$bkup/bin/airymaxrt" "$_entry" 2>/dev/null && chmod 755 "$_entry"; then
            log info "入口启动器已从备份恢复（自举源不可用）"
        else
            log warn "入口启动器恢复失败，请运行 install.sh --reinstall"
        fi
    fi
    # 回滚备份只保留最近 3 份（问题 11：rollback 目录无限膨胀清理）
    ls -1d "$AIRY_HOME"/.rollback/*/ 2>/dev/null | sort -r | tail -n +4 | while read -r old; do
        rm -rf "$old"
    done
    log ok "更新完成: v${new_ver}（重跑 airymaxrt 生效）"
    return 0
}

# 更新/重装后回收仍驻留内存的旧版本 daemon 群：热替换只换磁盘二进制，
# 运行中的进程仍执行旧代码（含旧 so 映射），必须回收；下次 airymaxrt
# 启动自然拉起新版本。pkill -f 按绝对路径匹配，避免误杀其他实例。
# daemon 清单以 bin/*_d 推导（增删不再改脚本硬编码）。
# 0.1.6h 修复：相对路径/cwd 启动的旧实例按 /proc/<pid>/exe 精确匹配
# 本安装根二进制后 kill；不用全局 pkill -x（曾误杀其他安装实例）。
stop_running_daemons() {
    local found=0 d n p exe
    for d in "$AIRY_HOME"/bin/*_d; do
        [ -f "$d" ] || continue
        d="${d##*/}"
        if [ -x "$AIRY_HOME/bin/$d" ]; then
            pkill -f "$AIRY_HOME/bin/$d" >/dev/null 2>&1 && found=1
            # 精确兜底（相对路径/独立 cwd 启动的旧实例）：仅终止二进制
            # 实际位于本安装根的同名进程。禁止全局 pkill -x（曾误杀其他
            # 安装实例的整群 daemon，多实例隔离破坏，2026-08-31 实测）。
            # Linux 专用（/proc 判 exe）；macOS 无 /proc，主匹配已覆盖。
            if [ -r /proc/self/exe ] && command -v pgrep >/dev/null 2>&1; then
                for p in $(pgrep -x "$d" 2>/dev/null); do
                    exe="$(readlink "/proc/$p/exe" 2>/dev/null)"
                    [ "${exe%% *}" = "$AIRY_HOME/bin/$d" ] || continue
                    kill "$p" 2>/dev/null && found=1
                done
            fi
            # 清理残留 socket：进程已停但 socket 文件可能残留，
            # 下次 _sock_alive 探测连接会拒绝，无需手动删（由拉起逻辑处理）
        fi
    done
    if [ "$found" = "1" ]; then
        sleep 2
        log info "旧版本 daemon 已自动停止（下次启动加载新版本）"
    fi
}

airymaxrt_update() { # update [--check] [--yes] [--channel stable|beta|rc] [--rollback] [--file <tarball>] [--sha256 <hash>]
    local CHECK=0 CHANNEL="" ROLLBACK=0 FILE="" SHA256="" inst_env="$AIRY_HOME/config/install.env"
    while [ $# -gt 0 ]; do
        case "$1" in
            --check|-c) CHECK=1 ;;
            --channel) CHANNEL="${2:-}"; shift ;;
            --rollback) ROLLBACK=1 ;;
            --file|-f) FILE="${2:-}"; shift ;;
            --sha256) SHA256="${2:-}"; shift ;;
            --yes|-y) : ;;   # 幂等：非交互本就默认继续
            *) log error "未知参数: $1（--check/--channel/--rollback/--file/--sha256）"; return 2 ;;
        esac
        shift
    done
    # 当前版本/通道（install.env 固化，安装信息只读）
    local cur_ver="" cur_ch="stable"
    if [ -f "$inst_env" ]; then
        cur_ver="$(sed -n 's/^AIRY_VERSION=//p' "$inst_env" | head -1)"
        cur_ch="$(sed -n 's/^AIRY_CHANNEL=//p' "$inst_env" | head -1)"
    fi
    CHANNEL="${CHANNEL:-${cur_ch:-stable}}"
    case "$CHANNEL" in stable|beta|rc) ;; *) log error "通道无效: $CHANNEL（stable|beta|rc）"; return 2 ;; esac

    # 回滚
    if [ "$ROLLBACK" = "1" ]; then
        local rb="$(ls -1d "$AIRY_HOME"/.rollback/*/ 2>/dev/null | sort -r | head -1)"
        [ -n "$rb" ] || { log error "无可用回滚备份（.rollback/ 为空）"; return 1; }
        log info "回滚到: $(basename "$rb")…"
        for d in bin lib include share; do
            [ -d "$rb/$d" ] && cp -rf "$rb/$d"/* "$AIRY_HOME/$d/" 2>/dev/null || true
        done
        # 恢复版本号（备份目录名 = <版本>-<时间戳>；剥离时间戳后缀，
        # 否则 AIRY_VERSION 被写成 v0.1.6g-20260831191248，后续版本比较错乱）
        if [ -f "$inst_env" ]; then
            local rb_ver="$(basename "$rb")"
            rb_ver="$(printf '%s' "$rb_ver" | sed -E 's/-[0-9]{14}$//')"
            if [ "$rb_ver" != "pre-update" ]; then
                sed_inplace "s|^AIRY_VERSION=.*|AIRY_VERSION=${rb_ver}|" "$inst_env" || \
                    printf 'AIRY_VERSION=%s\n' "$rb_ver" >> "$inst_env"
            fi
        fi
        log ok "回滚完成（重新运行 airymaxrt 生效）"
        return 0
    fi

    # 本地离线包更新（需 sha256 强制校验：--sha256 <hash> 或相邻 .sha256 文件，
    # 缺期望值拒绝 —— 问题 12：离线包不得绕过验签）
    if [ -n "$FILE" ]; then
        [ -f "$FILE" ] || { log error "本地包不存在: $FILE"; return 1; }
        local expect_sha="$SHA256"
        if [ -z "$expect_sha" ] && [ -f "${FILE}.sha256" ]; then
            expect_sha="$(cut -d' ' -f1 "${FILE}.sha256" 2>/dev/null)"
        fi
        if [ -z "$expect_sha" ]; then
            log error "离线包必须提供校验值：--sha256 <hash> 或相邻 ${FILE}.sha256（防供应链绕过）"
            return 1
        fi
        log info "应用本地离线包: $(basename "$FILE")（sha256 强制校验）…"
        apply_package "$FILE" "$expect_sha"
        local f_rc=$?
        [ "$f_rc" = "0" ] && stop_running_daemons
        return $f_rc
    fi

    # 远程通道更新（manifest 经 contents API 拉取：raw 域对 JSON 返回
    # HTML 预览页不可直连，见 fetch_repo_file 注释）
    local TMPD="$AIRY_HOME/tmp/update.$$"
    rm -rf "$TMPD"; mkdir -p "$TMPD"
    log info "检查更新（通道: ${CHANNEL}，当前: ${cur_ver:-<未安装>}）…"
    fetch_repo_file "latest/manifest.${CHANNEL}.json" "$TMPD/manifest.json" \
        || { log error "manifest 下载失败（latest/manifest.${CHANNEL}.json）"; rm -rf "$TMPD"; return 1; }
    fetch_repo_file "latest/manifest.${CHANNEL}.json.asc" "$TMPD/manifest.json.asc" >/dev/null 2>&1 || true
    verify_gpg_sig "$TMPD/manifest.json" "$TMPD/manifest.json.asc" || { log error "manifest 验签失败（GPG），拒绝更新"; rm -rf "$TMPD"; return 1; }
    log info "manifest 验签通过（GPG）"
    local latest="$(manifest_get "$TMPD/manifest.json" latest)"
    [ -n "$latest" ] || { log error "manifest 解析失败"; rm -rf "$TMPD"; return 1; }
    local cmp="$(ver_cmp "${cur_ver:-0.0.0}" "$latest")"
    if [ "$cmp" = "0" ] || [ "$cmp" = "1" ]; then
        log info "已是最新: ${cur_ver:-<未安装>}（最新 ${latest}）"
        rm -rf "$TMPD"
        return 0
    fi
    log info "发现新版本: ${cur_ver:-<未安装>} → ${latest}（${CHANNEL}）"
    [ "$CHECK" = "1" ] && { log info "仅检查模式：更新可用"; rm -rf "$TMPD"; return 0; }
    # 当前平台制品
    local plat="$(runtime_platform)"
    local art_url art_sha
    art_url="$(manifest_get "$TMPD/manifest.json" "artifact:${plat}" | sed -n 1p)"
    art_sha="$(manifest_get "$TMPD/manifest.json" "artifact:${plat}" | sed -n 2p)"
    # 平台键兼容（三代 manifest）：本版主键 = OS-架构族-位宽（如
    # linux-x86-64）；旧两代（gen2：linux-x64 等 / gen1：linux-x86_64 等）
    # 未命中时按 plat_legacy_name 候选依序反查（发布侧 manifest 亦含全部
    # 别名键，此处兜底旧 manifest）。
    if [ -z "$art_url" ]; then
        for legacy in $(plat_legacy_name "$plat"); do
            [ -n "$legacy" ] || continue
            art_url="$(manifest_get "$TMPD/manifest.json" "artifact:${legacy}" | sed -n 1p)"
            art_sha="$(manifest_get "$TMPD/manifest.json" "artifact:${legacy}" | sed -n 2p)"
            [ -n "$art_url" ] && { log warn "平台键 ${plat} 未命中，已用兼容命名 ${legacy}"; break; }
        done
    fi
    [ -n "$art_url" ] || {
        log error "当前平台 ${plat} 无可用制品"
        log error "若您安装的是旧版本（≤v0.1.6d），安装器已过旧无法自举更新；"
        log error "请重新执行一键安装命令（见官网 install 指南）更新安装器后重试。"
        rm -rf "$TMPD"; return 1
    }
    local tarball="$TMPD/$(basename "${art_url%%\?*}")"
    log info "下载制品: ${art_url}"
    syscurl -fsSL --max-time 600 -o "$tarball" "$art_url" || { log error "制品下载失败"; rm -rf "$TMPD"; return 1; }
    # sha256 校验收敛到 apply_package（fail-closed：manifest 缺 sha256 拒绝）
    apply_package "$tarball" "$art_sha"
    local rc=$?
    rm -rf "$TMPD"
    [ "$rc" = "0" ] && stop_running_daemons
    return $rc
}

# ── 子命令：help / status / doctor / uninstall ──────────────────────────────
# 86：CLI/TUI 随时转换——`cli` 子命令不直接 exec（否则跳过 daemon 群启动，
# CLI 直连 socket 时群未拉起会报"目标不存在"），而是置 FORCE_CLI 标记后
# 走统一默认流程：先确保守护进程群就绪，再由 launch_frontend 选择前端。
AIRYRT_FORCE_CLI=0
CLI_ARGS=()
CMD="${1:-}"
case "$CMD" in
    --help|-h|help)
        echo "用法: airymaxrt [--gateway-url URL] [--agent-file FILE]"
        echo "      airymaxrt cli [airy_cli 参数]  强制 CLI 模式（默认 TUI；随时可切换）"
        echo "      airymaxrt profile [full|minimal|auto]  查看/切换运行画像（硬件自适应）"
        echo "      airymaxrt monitor   硬件监控：检测到能力增强自动恢复功能"
        echo "                        （monitor --daemon 后台常驻 / --stop 停止）"
        echo "      airymaxrt status      查看运行时状态"
        echo "      airymaxrt doctor      组件健康检查"
        echo "      airymaxrt logs [N]    查看最近日志（默认 airymaxrt.log 末 50 行；"
        echo "                            logs <name> 看指定 daemon，如 logs llm_d）"
        echo "      airymaxrt update      自更新（--check 仅检查 / --channel stable|beta|rc"
        echo "                            切通道 / --rollback 回滚 / --file 离线包"
        echo "                            （离线包需 --sha256 或相邻 .sha256））"
        echo "      airymaxrt uninstall   一键卸载（--keep-data 保留记忆数据）"
        echo "      airymaxrt reinstall   强制重装（清缓存下载最新版 + 停旧 daemon）"
        exit 0
        ;;
    cli)
        # 86: CLI/TUI 随时转换——显式请求 CLI 前端（默认走 TUI）。
        # 透传剩余参数给 airy_cli；未传参数时以 TTY 交互模式运行。
        # 退出后重新执行 airymaxrt（无参数）即回到 TUI。
        if [ -z "$CLI_BIN" ]; then
            log error "airy_cli 未找到（CLI_BIN 为空）"
            exit 1
        fi
        AIRYRT_FORCE_CLI=1
        shift
        CLI_ARGS=("$@")
        ;;
    profile)
        # 2.3.2: 查看/切换运行画像（full|minimal|auto）。硬件变化（内存扩容、
        # 插入显卡等外设）后执行 `airymaxrt profile` 重新评估；指定画像时
        # 持久化并立即补齐被裁剪的能力 daemon。
        case "${2:-}" in
            ""|status)
                _HW="$(assess_hardware)"
                _HW_P="${_HW%%|*}"
                _HW_REST="${_HW#*|}"
                _MEM_TOTAL="${_HW_REST%%|*}"
                _MEM_REST="${_HW_REST#*|}"
                _MEM_AVAIL="${_MEM_REST%%|*}"
                _CPU="${_MEM_REST#*|}"
                _CPU="${_CPU%%|*}"
                _ACCEL="${_HW_REST##*|}"
                log info "当前画像: ${AIRYRT_PROFILE:-auto}（硬件建议: $_HW_P）"
                log info "硬件快照: $(detect_arch) · 内存 ${_MEM_TOTAL}KiB/可用 ${_MEM_AVAIL}KiB · CPU ${_CPU} 核 · 加速器 ${_ACCEL}"
                exit 0
                ;;
            full|minimal|auto)
                if [ "$2" = "auto" ]; then
                    _HW="$(assess_hardware)"
                    log info "自动评估画像: ${_HW%%|*}"
                    write_profile_state auto
                    AIRYRT_PROFILE="auto"
                else
                    write_profile_state "$2"
                    AIRYRT_PROFILE="$2"
                fi
                if [ "$AIRYRT_PROFILE" = "full" ]; then
                    log info "full 画像：补齐能力 daemon…"
                    ensure_aux_daemons
                fi
                log info "画像已生效: $AIRYRT_PROFILE（下次启动持久生效）"
                exit 0
                ;;
            *)
                log error "无效画像 '$2'（支持 full|minimal|auto）"
                exit 2
                ;;
        esac
        ;;
    monitor)
        # 2.3.2: 硬件监控——周期评估硬件画像，检测到能力增强（内存扩容/
        # 外设接入）时自动补齐被裁剪 daemon，实现"硬件变化自动恢复功能"；
        # 资源下降时提示主动裁剪。
        #   airymaxrt monitor              前台监控（Ctrl+C 干净退出）
        #   airymaxrt monitor --daemon     后台常驻（PID 记录 $RUNTIME_DIR/
        #                                   airymaxrt-monitor.pid）——端侧/服务
        #                                   器部署后无需保持终端，插入显卡等
        #                                   外设增强即自动恢复全量功能
        #   airymaxrt monitor --stop       停止后台监控
        # 判定依据：硬件建议画像与「当前生效画像」不一致即动作（而非前后
        # 两次建议比较——后者在 minimal 状态下永远等不到变化，增强永不触发）。
        case "${2:-}" in
            --daemon|--background|-d)
                _MON_PID_FILE="$RUNTIME_DIR/airymaxrt-monitor.pid"
                if [ -f "$_MON_PID_FILE" ] && \
                   [ -n "$(cat "$_MON_PID_FILE" 2>/dev/null)" ] && \
                   kill -0 "$(cat "$_MON_PID_FILE" 2>/dev/null)" 2>/dev/null; then
                    log warn "硬件监控已在后台运行（PID=$(cat "$_MON_PID_FILE" 2>/dev/null)）"
                    exit 0
                fi
                mkdir -p "$RUNTIME_DIR"
                # 递归以真实脚本绝对路径启动，避免软链/相对路径在后台失效；
                # 环境变量（AIRY_HOME/AIRYRT_PROFILE 等）已 export，子进程继承。
                nohup bash "$SCRIPT_DIR/airymaxrt" monitor \
                    >"$AIRY_HOME/logs/airymaxrt-monitor.log" 2>&1 &
                echo "$!" >"$_MON_PID_FILE"
                log info "硬件监控后台运行（PID=$!，日志 $AIRY_HOME/logs/airymaxrt-monitor.log）"
                exit 0
                ;;
            --stop)
                _MON_PID_FILE="$RUNTIME_DIR/airymaxrt-monitor.pid"
                if [ -f "$_MON_PID_FILE" ]; then
                    _MON_PID="$(cat "$_MON_PID_FILE" 2>/dev/null)"
                    if [ -n "$_MON_PID" ] && kill -0 "$_MON_PID" 2>/dev/null; then
                        kill "$_MON_PID" 2>/dev/null
                        log info "硬件监控已停止（PID=$_MON_PID）"
                    else
                        log warn "硬件监控未在运行（陈旧 PID 文件）"
                    fi
                    rm -f "$_MON_PID_FILE"
                else
                    log warn "未找到后台监控 PID 文件（未在后台运行？）"
                fi
                exit 0
                ;;
        esac
        trap 'log info "硬件监控退出"; exit 0' INT TERM
        _INT="${AIRYRT_MONITOR_INTERVAL:-10}"
        _HINTED=""   # 已提示的画像值：差异持续时只提示一次，回归一致后重置
        log info "硬件监控启动（间隔 ${_INT}s，Ctrl+C 退出），当前画像: ${AIRYRT_PROFILE}"
        while true; do
            _HW="$(assess_hardware)"
            _CUR="${_HW%%|*}"
            _SNAP="${_HW#*|}"
            # 外设变化检测：加速器增删（插卡/拔卡、驱动启用/禁用）不改变
            # 画像但改变本地推理能力——与画像固化值对比，变化即提示并刷新
            # profile.env（AIRY_HW_ACCEL）。AIRY_HW_ACCEL 由 install.sh
            # persist_profile 固化、本脚本启动时 source 导入。
            _ACCEL_NOW="${_SNAP##*|}"
            _ACCEL_BASE="${AIRY_HW_ACCEL:-none}"
            if [ "$_ACCEL_NOW" != "$_ACCEL_BASE" ]; then
                log info "外设变化: 加速器 ${_ACCEL_BASE} → ${_ACCEL_NOW}"
                upsert_profile_var AIRY_HW_ACCEL "$_ACCEL_NOW"
                if [ "$_ACCEL_NOW" != "none" ]; then
                    log info "检测到加速器（${_ACCEL_NOW}），本地推理能力可用（可配置本地模型）"
                else
                    log warn "加速器已不可见，本地推理将不可用（远程 LLM 不受影响）"
                fi
            fi
            if [ "$_CUR" != "$AIRYRT_PROFILE" ]; then
                if [ "$_CUR" = "full" ]; then
                    if [ "$AIRYRT_PROFILE_RAW" != "auto" ]; then
                        if [ "$_HINTED" != "$_CUR" ]; then
                            log warn "检测到硬件能力增强（$_SNAP），但画像为显式设置 ${AIRYRT_PROFILE}"
                            log warn "执行 'airymaxrt profile full' 可立即恢复全量功能"
                            _HINTED="$_CUR"
                        fi
                    else
                        log info "检测到硬件能力增强（$_SNAP），自动恢复全量功能"
                        write_profile_state full
                        AIRYRT_PROFILE=full
                        ensure_aux_daemons
                        _HINTED=""
                    fi
                elif [ "$_HINTED" != "$_CUR" ]; then
                    log warn "检测到资源下降（$_SNAP，建议 minimal），当前画像 ${AIRYRT_PROFILE}"
                    log warn "可执行 'airymaxrt profile minimal' 主动裁剪，或重启进入 minimal"
                    _HINTED="$_CUR"
                fi
            else
                _HINTED=""
            fi
            sleep "$_INT"
        done
        ;;
    status)
        log info "AIRY_HOME=$AIRY_HOME"
        log info "画像: ${AIRYRT_PROFILE:-auto} · 架构: $(detect_arch) · 加速器: $(detect_accel)"
        log info "组件: TUI=${TUI_BIN:-缺失} GATEWAY=${GATEWAY_BIN:-缺失} LLM=${LLM_BIN:-缺失}"
        # PATH 引导闭环（2.3.2.6）：安装器（build.sh/install.sh）把 BIN_DIR
        # 是否在 PATH 固化进 install.env，此处消费并向用户给出可复制修复命令，
        # 避免"装上了却输入 airymaxrt 报 command not found"的困惑。
        if [ -f "$AIRY_HOME/config/install.env" ]; then
            _BP="$(sed -n 's/^AIRY_BIN_DIR_IN_PATH=//p' "$AIRY_HOME/config/install.env" 2>/dev/null | head -1)"
            _BL="$(sed -n 's/^AIRY_BIN_LINK=//p' "$AIRY_HOME/config/install.env" 2>/dev/null | head -1)"
            _BL="${_BL:-$HOME/.local/bin/airymaxrt}"
            _BD="${_BL%/airymaxrt}"
            if [ "$_BP" = "no" ]; then
                log warn "PATH 引导: ${_BD} 不在 PATH 中——当前 shell 输入 airymaxrt 会报 command not found"
                log warn "  临时生效: export PATH=\"${_BD}:\$PATH\""
                _RC_S="$HOME/.bashrc"
                case "$(basename "${SHELL:-/bin/sh}")" in
                    zsh) _RC_S="$HOME/.zshrc" ;;
                    fish) _RC_S="$HOME/.config/fish/config.fish" ;;
                    sh|dash|ash) _RC_S="$HOME/.profile" ;;
                esac
                log warn "  永久生效: echo 'export PATH=\"${_BD}:\$PATH\"' >> \"${_RC_S}\" && source \"${_RC_S}\""
            else
                log info "PATH 引导: ${_BD} 已在 PATH 中（输入 airymaxrt 即可启动）"
            fi
        fi
        if wait_for_health "$GATEWAY_URL" 1; then
            log info "gateway: 在线（$GATEWAY_URL）"
        else
            log warn "gateway: 离线"
        fi
        # daemon 群状态以关键 socket 可连接为权威判据（_sock_alive 含
        # health_check 往返）。不用 pgrep：进程名匹配会把容器/其他实例的
        # 同名进程算作本实例运行中，出现「status 显示运行中但 gateway 离线、
        # llm.sock 未就绪」的矛盾（2026-08-22）。llm/think/agent/tool 是
        # 对话与执行的核心链路，任一未就绪即提示不完整。
        _core_ok=1
        for _c in llm think agent tool; do
            if ! _sock_alive "$RUNTIME_DIR/$_c.sock"; then
                log warn "$_c.sock: 未就绪"
                _core_ok=0
            fi
        done
        if [ "$_core_ok" = "1" ]; then
            log info "daemon 群: 核心链路（llm/think/agent/tool）全部就绪"
        else
            log warn "daemon 群: 核心链路未全部就绪（运行 airymaxrt 拉起，或查看 logs/ 诊断）"
        fi
        exit 0
        ;;
    doctor)
        miss=0
        for name in TUI_BIN GATEWAY_BIN LLM_BIN THINK_BIN; do
            eval "val=\${$name:-}"
            if [ -n "$val" ] && [ -x "$val" ]; then log info "$name: $val"; else log warn "$name: 缺失"; miss=1; fi
        done
        if [ -f "$AIRY_HOME/config/secrets.env" ]; then log info "secrets.env: 就绪"; else log warn "secrets.env: 缺失（LLM 不可用）"; miss=1; fi
        if [ -f "$AIRY_HOME/config/install.env" ]; then log info "install.env: 就绪"; else log warn "install.env: 缺失"; fi
        if command -v curl >/dev/null 2>&1; then log info "curl: 就绪"; else log warn "curl: 缺失"; miss=1; fi
        # PATH 引导检查（2.3.2.6）：install.env 固化结果 + 实时 PATH 双重校验，
        # 实时校验可捕获安装后用户改 PATH 的场景。BIN_DIR 按段遍历（对含
        # 空格/glob 字符的路径健壮），永久生效提示按当前 shell 选 rc 文件。
        _BL_D="$(sed -n 's/^AIRY_BIN_LINK=//p' "$AIRY_HOME/config/install.env" 2>/dev/null | head -1)"
        _BL_D="${_BL_D:-$HOME/.local/bin/airymaxrt}"
        _BD_D="${_BL_D%/airymaxrt}"
        _PATH_FOUND=0
        _P_SEG="$PATH"
        while [ -n "$_P_SEG" ]; do
            _seg="${_P_SEG%%:*}"
            if [ "$_seg" = "$_BD_D" ]; then
                _PATH_FOUND=1
                break
            fi
            if [ "$_seg" = "$_P_SEG" ]; then _P_SEG=""; else _P_SEG="${_P_SEG#*:}"; fi
        done
        if [ "$_PATH_FOUND" = "1" ]; then
            log info "PATH: ${_BD_D} 在 PATH 中"
        else
            log warn "PATH: ${_BD_D} 不在 PATH 中——输入 airymaxrt 会报 command not found"
            _RC_D="$HOME/.bashrc"
            case "$(basename "${SHELL:-/bin/sh}")" in
                zsh) _RC_D="$HOME/.zshrc" ;;
                fish) _RC_D="$HOME/.config/fish/config.fish" ;;
                sh|dash|ash) _RC_D="$HOME/.profile" ;;
            esac
            log warn "  永久生效: echo 'export PATH=\"${_BD_D}:\$PATH\"' >> \"${_RC_D}\" && source \"${_RC_D}\""
            miss=1
        fi
        # 运行库完整性（0.1.6e 防御：旧用户热替换不完整/缺库导致 daemon 群
        # 起不来——如 Ubuntu 24.04 缺 libssl.so.1.1）。逐个关键二进制
        # ldd 检测 not found；缺库即提示 reinstall 干净重装。
        _LD_MISS=""
        for _b in "$AIRY_HOME"/bin/*_d "$AIRY_HOME"/bin/airy_cli "$AIRY_HOME"/bin/agentrt-tui; do
            [ -x "$_b" ] || continue
            _nf="$(ldd "$_b" 2>/dev/null | grep -F 'not found' || true)"
            if [ -n "$_nf" ]; then
                _LD_MISS="$_LD_MISS
  $(basename "$_b"): $(echo "$_nf" | sed 's/.*=> not found/缺/' | tr '\n' '; ')"
                miss=1
            fi
        done
        if [ -n "$_LD_MISS" ]; then
            log warn "运行库缺失（daemon 将无法启动）:$_LD_MISS"
            log warn "  修复: airymaxrt reinstall（干净重装，保留 config/data）"
        else
            log info "运行库: 全部可解析"
        fi
        if [ "$miss" = "0" ]; then log info "doctor: 全部就绪"; else log warn "doctor: 存在缺失项"; fi
        exit 0
        ;;
    logs)
        # 社区反馈：status 提示"查看 logs/ 诊断"，但无 logs 子命令，用户只能
        # 手敲路径。logs [N] 看主日志末 N 行（默认 50）；logs <name> [N] 看指定
        # daemon 输出（如 logs llm_d → logs/llm_d.out，自动补 .out/.log 后缀）。
        _arg="${2:-}"
        _n=50
        _file="$AIRY_HOME/logs/airymaxrt.log"
        case "$_arg" in
            "") ;;
            *[!0-9]*)
                # 非纯数字 → 视为 daemon 名
                if [ -f "$AIRY_HOME/logs/$_arg" ]; then
                    _file="$AIRY_HOME/logs/$_arg"
                elif [ -f "$AIRY_HOME/logs/${_arg}.out" ]; then
                    _file="$AIRY_HOME/logs/${_arg}.out"
                elif [ -f "$AIRY_HOME/logs/${_arg}.log" ]; then
                    _file="$AIRY_HOME/logs/${_arg}.log"
                else
                    log error "未找到日志: $_arg（可用: $(ls "$AIRY_HOME/logs" 2>/dev/null | tr '\n' ' ')）"
                    exit 1
                fi
                _n="${3:-50}"
                ;;
            *)
                _n="$_arg"
                ;;
        esac
        case "$_n" in
            *[!0-9]*|"") _n=50 ;;
        esac
        if [ ! -f "$_file" ]; then
            log error "日志文件不存在: $_file"
            exit 1
        fi
        echo "── $_file（末 ${_n} 行）────────────────────────────" >&2
        tail -n "$_n" "$_file"
        exit 0
        ;;
    uninstall)
        inst="${AIRY_HOME}/scripts/install.sh"
        if [ -f "$inst" ]; then
            log info "委托安装器执行卸载: $inst"
            shift
            exec sh "$inst" --uninstall "$@"
        else
            log warn "未找到安装器脚本，请手动删除: $AIRY_HOME"
            exit 1
        fi
        ;;
    reinstall)
        inst="${AIRY_HOME}/scripts/install.sh"
        if [ -f "$inst" ]; then
            log info "委托安装器执行重装: $inst"
            shift
            # 0.1.6h 修复：非默认位置安装的用户重装到错误路径（install.sh
            # 强制忽略环境变量 AIRY_HOME，防残留劫持）；显式传 --prefix。
            if [ "$AIRY_HOME" != "${HOME}/.airymaxrt" ]; then
                exec sh "$inst" --reinstall --prefix "$AIRY_HOME" "$@"
            fi
            exec sh "$inst" --reinstall "$@"
        else
            log warn "未找到安装器脚本: $inst（请重新运行官方 install.sh 一键安装）"
            exit 1
        fi
        ;;
    update)
        # 自更新器：检查/执行官方通道更新（stable|beta），GPG 验签 + sha256 校验
        shift
        airymaxrt_update "$@"
        exit $?
        ;;
esac
# 正常启动：透传剩余参数给 TUI
# 终端日志统一默认 quiet：INFO 只写日志文件、不打印终端。全屏 TUI 下
# 避免与界面混排；CLI 流式（-p）下 stdout 承载对话结果，启动 INFO 混入
# 会污染输出（用户反馈"对话结果和日志混在一起"）。warn/error 仍打印
# 终端（启动失败的可见性不牺牲）。显式 AIRYRT_TERM_LOG=verbose 可恢复
# 终端 INFO（排查 daemon 拉起时序用）。
if [ -z "${AIRYRT_TERM_LOG:-}" ]; then
    AIRYRT_TERM_LOG=quiet
fi

# ── 前置检查 ─────────────────────────────────────────────────────────────────
# TUI 与 CLI 至少需要一个：TUI 缺失时降级到 airy_cli（有 TTY 亦同）。
if [ -z "$TUI_BIN" ] && [ -z "$CLI_BIN" ]; then
    log error "未找到 agentrt-tui 与 airy_cli，请先构建："
    log error "  TUI: cd \"$AIRYRT_HOME/sdk/tui\" && cargo build --release"
    log error "  CLI: cd \"$AIRYRT_HOME/agentrt\" && cmake --build build --target airy_cli"
    exit 1
fi
if [ -n "$TUI_BIN" ]; then
    log info "组件就绪: TUI=$(basename "$TUI_BIN")"
else
    log warn "agentrt-tui 未找到，将使用 airy_cli 作为前端"
fi

# PATH 自愈兜底：BIN_DIR 不在 PATH 时自动追加 rc（幂等），
# 兼容旧安装（安装时未自动引导）与安装后手动改 PATH 的场景。
path_self_heal

# ── 智能双模前端启动（2026-08-15 用户决策：所有端统一经 airymaxrt 启动）──
#   有 TTY（交互终端/SSH -t） → Rust TUI（全屏，交互丰富）
#   无 TTY（管道/CI/脚本重定向）→ C 版 airy_cli 流式（-p 单轮，stdin 读指令）
# 前端以子进程运行：bash 保持信号处理能力，外部强杀经 trap 转 exit，
# cleanup 可回收前端与本次拉起的 daemons。
# 交互前端独占屏幕：清屏后 hero/banner 从屏幕第 1 行开始渲染。
# 不清屏时 boot 输出（"正在启动守护进程群…"等）占据顶部数行，hero 从
# boot 之后打印，而 cli_term_header_pin 固定从第 7 行设滚动区——对话
# 输出从第 7 行起覆盖 hero 下半部（2026-08-20 实测复现：英雄区只剩
# 一行框线）。boot 进度已完整记录于 airymaxrt.log，此处仅清当前屏。
clear_front_screen() {
    if [ -t 1 ]; then
        printf '\033[2J\033[H' >&1
    fi
}

# ── 终端全屏能力评估（2026-08-21）────────────────────────────────────────
# TUI 除需要 TTY 外，还要求终端具备全屏渲染能力：
#   - TERM=dumb/unknown/空（cron、脚本化环境、部分 CI）→ 不支持 ANSI 全屏
#   - 屏幕过小（<20 行或 <60 列）→ 三区布局/侧边栏无法完整渲染
# 满足条件才启用 Rust TUI；否则自动降级 airy_cli（TTY 交互 / 非 TTY 流式），
# 实现"显示能力实时适配、自动切换最优前端"。AIRYRT_FORCE_TUI=1 强制 TUI。
terminal_capable_tui() {
    [ -n "${AIRYRT_FORCE_TUI:-}" ] && return 0
    local term rows cols
    term="${TERM:-dumb}"
    case "$term" in
        dumb|unknown|"") return 1 ;;
    esac
    if command -v stty >/dev/null 2>&1; then
        read -r rows cols < <(stty size 2>/dev/null || printf "24 80")
        if [ "${rows:-0}" -lt 20 ] || [ "${cols:-0}" -lt 60 ]; then
            log debug "终端尺寸过小（${rows}x${cols}），TUI 降级 CLI"
            return 1
        fi
    fi
    return 0
}

launch_frontend() {
    log debug "TTY 检测: stdin=$([ -t 0 ] && echo tty || echo pipe) stdout=$([ -t 1 ] && echo tty || echo pipe)"
    # tmp 清理（1.8.3）：$AIRY_HOME/tmp 为易失运行时目录——取消会话残留
    # （airy_cl3_cancel_* 等）超过 24h 未修改的旧文件/目录在每次进入前端前
    # 回收，避免 tmp 无限膨胀（运行中的会话 mtime 新鲜，不受影响）。
    if [ -d "$AIRY_HOME/tmp" ]; then
        find "$AIRY_HOME/tmp" -mindepth 1 -mtime +1 -exec rm -rf {} + 2>/dev/null
        log debug "tmp 清理: 已回收超过 24h 未修改的临时文件/目录"
    fi
    # 86：显式 CLI 模式（airymaxrt cli [airy_cli 参数]）。带参数时透传
    # （如 -p "指令" 单轮流式）；无参数且为 TTY 时进入 CLI 交互模式。
    if [ "$AIRYRT_FORCE_CLI" = "1" ]; then
        if [ -n "$CLI_BIN" ]; then
            if [ -t 0 ] && [ -t 1 ] && [ "${#CLI_ARGS[@]}" -eq 0 ]; then
                clear_front_screen
                log debug "执行: \"$CLI_BIN\"（CLI 交互模式，TUI 让位）"
                log info "进入交互界面（airy_cli，Ctrl+C 退出）"
                "$CLI_BIN" <&0 &
            else
                log debug "执行: \"$CLI_BIN\" ${CLI_ARGS[*]:-}"
                "$CLI_BIN" "${CLI_ARGS[@]}" <&0 &
            fi
            TUI_PID=$!
            wait "$TUI_PID" || return $?
            return 0
        fi
        log warn "airy_cli 不可用，回退默认前端"
    fi
    # 前端选择：有 TTY 且 TUI 可用 → Rust TUI；否则 → airy_cli。
    # airy_cli 在 TTY 下以交互模式运行（无 -p），支持完整对话。
    # 前端子进程必须显式继承脚本 stdin（<&0）：非交互 bash 会把后台命令的
    # stdin 重定向为 /dev/null（POSIX 行为），导致 TUI 收不到按键、CLI
    # 的 fgets 立即 EOF（表现为「airymaxrt 无输出即退出」）。
    if [ -t 0 ] && [ -t 1 ] && [ -n "$TUI_BIN" ] && [ "$GATEWAY_DOWN" != "1" ] && terminal_capable_tui; then
        clear_front_screen
        log debug "执行: \"$TUI_BIN\" --gateway-url \"$GATEWAY_URL\" --agent-file \"$AGENT_FILE\""
        log info "进入交互界面（Rust TUI，Ctrl+C 退出）"
        "$TUI_BIN" --gateway-url "$GATEWAY_URL" --agent-file "$AGENT_FILE" <&0 &
        TUI_PID=$!
        wait "$TUI_PID"
        local rc=$?
        # TUI 异常退出（崩溃/被信号打断，code≠0）且终端仍交互 → 无缝续接
        # CLI 交互模式，保证会话不中断（2.2.2 CLI/TUI 随时转换）。正常
        # 退出（用户 Q，code=0）则按用户意愿结束。
        if [ "$rc" -ne 0 ] && [ -n "$CLI_BIN" ] && [ -t 0 ] && [ -t 1 ]; then
            log warn "TUI 异常退出（code=$rc），自动续接 CLI 交互模式"
            clear_front_screen
            log info "进入交互界面（airy_cli，/quit 退出）"
            "$CLI_BIN" <&0 &
            TUI_PID=$!
            wait "$TUI_PID"
        fi
        return 0
    elif [ -n "$CLI_BIN" ]; then
        if [ -t 0 ] && [ -t 1 ]; then
            clear_front_screen
            log debug "执行: \"$CLI_BIN\"（TTY 交互模式，TUI 不可用降级）"
            log info "进入交互界面（airy_cli，Ctrl+C 退出）"
            "$CLI_BIN" <&0 &
        else
            log debug "执行: \"$CLI_BIN\" -p（非 TTY 流式单轮，stdin 读指令）"
            log info "进入流式 CLI（airy_cli，非 TTY 环境；stdin 读指令）"
            "$CLI_BIN" -p <&0 &
        fi
    else
        clear_front_screen
        log warn "airy_cli 不可用，回退 Rust TUI（可能需要 TTY）"
        "$TUI_BIN" --gateway-url "$GATEWAY_URL" --agent-file "$AGENT_FILE" <&0 &
    fi
    TUI_PID=$!
    wait "$TUI_PID" || return $?
    return 0
}

# ── 状态判断：gateway 是否在线 ───────────────────────────────────────────
# 重要：gateway 在线 ≠ daemon 群在线。常驻 gateway 在前次会话后可能仍存活，
# 而 llm/agent/tool 等 daemon 已退出——此前逻辑在 gateway 在线时直接进入
# 界面、不拉起 daemon，表现为"界面能进、对话全挂（服务不可达）"。
# 统一改为：无论 gateway 状态如何，先确保 daemon 群就绪（缺失即拉起），
# 再决定前端（TUI 依赖 gateway；CLI 直连 daemon 群）。
GATEWAY_DOWN=0
GATEWAY_ALIVE=0
if wait_for_health "$GATEWAY_URL" 1; then
    GATEWAY_ALIVE=1
    log info "gateway 在线（$GATEWAY_URL），本次复用（不重复拉起）"
else
    log info "gateway 离线（$GATEWAY_URL），将一并拉起"
fi
log info "确保守护进程群就绪…"
boot_line "正在启动守护进程群…"

# ── 拉起守护进程（仅本次会话，退出后清理） ─────────────────────────────────
DAEMONS_STARTED=0
ALL_DAEMON_PIDS=()
GATEWAY_PID=""
TUI_PID=""

# _stop_all <PID...>：并行 TERM → 统一轮询 → KILL 兜底，确保进程真正退出。
# 相对旧版逐个停止（16 个 daemon 串行 TERM+轮询可累加至数十秒），并行回收
# 的总时长收敛为最慢单个进程的退出时间（实测多数 daemon 2-6s 内优雅退出）。
_stop_all() {
    local pids=("$@") i j remaining deadline
    [ "${#pids[@]}" -eq 0 ] && return 0
    log debug "并行停止 ${#pids[@]} 个进程：发送 TERM"
    for i in "${!pids[@]}"; do
        if kill -0 "${pids[$i]}" 2>/dev/null; then
            kill "${pids[$i]}" 2>/dev/null || true
        else
            pids[$i]=""   # 已退出，标记跳过
        fi
    done
    # 统一轮询（0.5s 步长，最长 15s）：守护进程需执行完整清理链
    # （IPC/SD 心跳 join/传输 teardown），过短会误杀优雅清理中的进程。
    deadline=$((SECONDS + 15))
    remaining="${#pids[@]}"
    while [ "$remaining" -gt 0 ] && [ "$SECONDS" -lt "$deadline" ]; do
        remaining=0
        for j in "${!pids[@]}"; do
            [ -n "${pids[$j]}" ] || continue
            if ! kill -0 "${pids[$j]}" 2>/dev/null; then
                log info "已停止进程（PID=${pids[$j]}）"
                pids[$j]=""
            else
                remaining=$((remaining + 1))
            fi
        done
        [ "$remaining" -gt 0 ] && sleep 0.5
    done
    # 未响应 TERM 的残留进程强制 KILL
    for j in "${!pids[@]}"; do
        if [ -n "${pids[$j]}" ] && kill -0 "${pids[$j]}" 2>/dev/null; then
            log warn "进程（PID=${pids[$j]}）未响应 TERM，强制 KILL"
            kill -9 "${pids[$j]}" 2>/dev/null || true
        fi
    done
}

cleanup() {
    if [ "$DAEMONS_STARTED" != "1" ] && [ -z "$TUI_PID" ]; then
        log debug "清理跳过：本次未拉起任何进程"
        return 0
    fi
    log debug "清理开始：停止本次拉起的 TUI 与守护进程"
    # 收集本次拉起的全部进程（TUI + gateway + daemons），并行 TERM 回收。
    # 注意：无论 gateway 是否复用（GATEWAY_PID 可能为空），本次会话拉起的
    # daemon 一律回收——此前以 GATEWAY_PID 非空为门，复用场景下 daemon 不
    # 被停止，cleanup 末尾 `wait` 等待未退出的 daemon 子进程而永久挂起。
    local stop_pids=()
    [ -n "$TUI_PID" ] && stop_pids+=("$TUI_PID")
    [ -n "$GATEWAY_PID" ] && stop_pids+=("$GATEWAY_PID")
    stop_pids+=("${ALL_DAEMON_PIDS[@]}")
    _stop_all "${stop_pids[@]}"
    wait 2>/dev/null || true
    # 清理本次拉起的 daemon socket 文件（2.2 启动优化）：优雅退出后
    # unlink 本次登记的 socket，避免 stale socket 残留污染 run 目录——
    # 残留 socket 会让后续 status 误报"未就绪"、甚至被复用判定误用。
    # DAEMON_SOCKS 只登记本次拉起（复用实例不在其中，不受影响），且
    # 不随 wait_all_socks 缩减，保证退出时完整清理。
    for sock in "${DAEMON_SOCKS[@]:-}"; do
        if [ -n "$sock" ] && [ -S "$sock" ]; then
            rm -f "$sock" 2>/dev/null
            log debug "清理 stale socket: $sock"
        fi
    done
    log debug "清理完成"
}
trap cleanup EXIT
# 外部信号（如 timeout 强杀）转入 exit 路径，确保 EXIT trap（cleanup）执行，
# 不残留本次拉起的 TUI / gateway_d / llm_d 进程。bash 默认对未 trap 的
# SIGTERM 直接终止、不执行 EXIT trap，这正是此前残留的根因。
trap 'exit 143' TERM
trap 'exit 130' INT

if [ -z "$GATEWAY_BIN" ] && [ -z "$LLM_BIN" ]; then
    log warn "gateway_d 与 llm_d 均未找到，将以 OFFLINE 模式进入（对话功能不可用）。"
    log warn "构建 daemons：cd \"$AIRYRT_HOME/agentrt\" && cmake -B build && cmake --build build -j"
else
    # ---- 清理 run/ 下的 stale pid 文件（2026-08-22）----
    # bootstrap 时代的 daemon 退出后残留 *.pid（airymaxrt 自身不写 pid 文件），
    # 干扰 run 目录观感且误导诊断。启动前统一清理：pid 无对应存活进程即删。
    # 存活进程的 pid 文件保留（避免误删正在运行实例的标记）。
    for _pf in "$RUNTIME_DIR"/*.pid; do
        [ -f "$_pf" ] || continue
        _p="$(cat "$_pf" 2>/dev/null)"
        if [ -z "$_p" ] || ! kill -0 "$_p" 2>/dev/null; then
            rm -f "$_pf"
            log debug "清理 stale pid 文件: $_pf"
        fi
    done
    # ---- 运行时日志清理（2.2.1.7 强化运行时日志）----
    # agent 子进程日志（logs/agent_*.log）无轮转会无限累积；daemon 的
    # *.out（stdout/stderr 重定向）同样只增不减。启动前清理 7 天前的
    # 陈旧文件（保留近期便于排障），幂等且不影响正在写入的当前日志。
    _LOG_KEEP_DAYS="${AIRYRT_LOG_KEEP_DAYS:-7}"
    if command -v find >/dev/null 2>&1 && [ -d "$AIRY_HOME/logs" ]; then
        _CUTOFF=$(( $(date +%s) - _LOG_KEEP_DAYS * 86400 ))
        while IFS= read -r _old; do
            [ -n "$_old" ] || continue
            rm -f "$_old"
            log debug "清理过期运行时日志: $_old"
        done < <(find "$AIRY_HOME/logs" -maxdepth 1 -type f \
                     \( -name 'agent_*.log' -o -name '*.out' -o -name '*.pid' \) \
                     ! -newermt "@$_CUTOFF" -print 2>/dev/null)
    fi
    # ---- 并行拉起全部守护进程（0.1.2 启动优化） ----
    # 16 个 Unix socket daemon + gateway_d 一次性后台拉起：daemon 启动即 bind
    # 自身 socket，对等连接在请求时建立，启动互不阻塞；随后统一轮询等待全部
    # socket 就绪。相对旧版顺序拉起（16 个串行、每个 1s 轮询粒度 ≈ 17s），
    # 并行版总耗时收敛为最慢单个 daemon 的启动时间（实测 ~2s）。
    ALL_DAEMON_PIDS=()   # 本次拉起的 daemon PID（cleanup 统一回收）
    DAEMONS_STARTED=1
    REUSED_COUNT=0       # 复用已在线实例数（状态展示用，避免误导"0 个"）
    declare -a WAIT_SOCKS=()   # 待等待 socket 规格：`名称|socket路径`
    declare -a DAEMON_SOCKS=() # 本次拉起的 socket 路径（cleanup 清理用）
    # 本次拉起的 socket 路径（只增不减，独立于 WAIT_SOCKS）：wait_all_socks
    # 会随就绪把条目移出 WAIT_SOCKS，cleanup 若用 WAIT_SOCKS 清理会因数组已
    # 空而漏删残留 socket（2.2 启动优化）。

    # _launch_daemon <bin> <socket路径>：后台拉起并登记等待（不等待就绪）。
    # 去重与 stale socket 处理沿用顺序版逻辑；返回 0=已复用/已拉起。
    _launch_daemon() {
        local bin="$1" sock="$2" bname
        bname="${bin##*/}"
        bname="${bname:-daemon}"
        if [ ! -x "$bin" ]; then
            log warn "$bname 未找到，跳过"
            return 0
        fi
        # 去重：同名 daemon 已运行（socket 可连接 → 进程真实监听）→ 复用。
        # 判定用连接探测而非 pgrep -f 完整路径：daemon 以相对路径启动时
        # pgrep 匹配不到，会误判离线而重复拉起（历史故障：多实例抢占
        # tool.sock/llm.sock，新实例 unlink 旧 socket 造成死链）。
        if _sock_alive "$sock"; then
            REUSED_COUNT=$((REUSED_COUNT + 1))
            log info "$bname 已在运行（复用 $sock）"
            return 0
        fi
        # socket 存在但无监听（崩溃残留/上次会话未清理）→ 先移除，否则
        # 新实例 bind 报 Address already in use 而启动失败。
        if [ -S "$sock" ]; then
            log warn "$bname 检测到 stale socket（无监听），移除后重新拉起: $sock"
            rm -f "$sock"
        fi
        # nohup 忽略 SIGHUP：终端会话异常退出（SSH 断连/终端关闭）时 daemon
        # 不被进程组 SIGHUP 连带杀死（历史故障：会话退出后 daemon 群全灭、
        # 残留 defunct 僵尸）。$! 语义不变（nohup 对可执行文件直接 exec），
        # cleanup 按 PID TERM 回收仍有效；正常退出（TUI/CLI 结束）时由
        # cleanup 主动回收本次拉起的 daemon，行为与之前一致。
        nohup "$bin" >"$AIRY_HOME/logs/${bname}.out" 2>&1 &
        ALL_DAEMON_PIDS+=("$!")
        WAIT_SOCKS+=("$bname|$sock")
        DAEMON_SOCKS+=("$sock")
        log info "$bname 已拉起（PID=$!），日志: $AIRY_HOME/logs/${bname}.out"
    }

    # ---- 并行拉起 17 个 socket daemon ----
    # llm_d：核心依赖，--manager 指定模型配置（provider/endpoint 来源）
    if [ -x "$LLM_BIN" ]; then
        if _sock_alive "$RUNTIME_DIR/llm.sock"; then
            REUSED_COUNT=$((REUSED_COUNT + 1))
            log info "llm_d 已在运行（复用 $RUNTIME_DIR/llm.sock）"
        else
            if [ -S "$RUNTIME_DIR/llm.sock" ]; then
                log warn "llm_d 检测到 stale socket（无监听），移除后重新拉起: $RUNTIME_DIR/llm.sock"
                rm -f "$RUNTIME_DIR/llm.sock"
            fi
            if [ -f "$MODEL_CONFIG" ]; then
                log debug "llm_d 使用模型配置: $MODEL_CONFIG"
                nohup "$LLM_BIN" --manager "$MODEL_CONFIG" >"$AIRY_HOME/logs/llm_d.out" 2>&1 &
            else
                log warn "模型配置不存在（$MODEL_CONFIG），llm_d 使用默认配置"
                nohup "$LLM_BIN" >"$AIRY_HOME/logs/llm_d.out" 2>&1 &
            fi
            ALL_DAEMON_PIDS+=("$!")
            WAIT_SOCKS+=("llm_d|$RUNTIME_DIR/llm.sock")
            DAEMON_SOCKS+=("$RUNTIME_DIR/llm.sock")
            log info "llm_d 已拉起（PID=$!），日志: $AIRY_HOME/logs/llm_d.out"
        fi
    fi

    # think_d：双思考（GCCP+GRAD），gateway 经 think.sock 调用
    if [ -n "$THINK_BIN" ]; then
        _launch_daemon "$THINK_BIN" "$RUNTIME_DIR/think.sock"
    else
        log warn "think_d 未找到，双思考（GCCP+GRAD）不可用，gateway 将降级直连"
    fi

    # 其余 daemon：full 画像全量接线（agent/tool/hook/plugin/monit/sched/
    # channel/market/cupolas/mem/a2a/info/notify/observe）；minimal 画像仅
    # 保留核心执行链路（agent/tool），其余能力 daemon 不拉起（gateway 自动
    # 降级），以控制低内存设备的内存占用（AIRYRT_PROFILE=minimal）。
    _launch_daemon "$(find_tool AIRY_AGENT_BIN agent_d "$AIRY_HOME/bin/agent_d" "$AIRYRT_HOME/agentrt/build/bin/agent_d" "$AIRYRT_HOME/build/bin/agent_d")" "$RUNTIME_DIR/agent.sock"
    _launch_daemon "$(find_tool AIRY_TOOL_BIN tool_d "$AIRY_HOME/bin/tool_d" "$AIRYRT_HOME/agentrt/build/bin/tool_d" "$AIRYRT_HOME/build/bin/tool_d")" "$RUNTIME_DIR/tool.sock"
    # 0.1.6h 自动计算：其余能力 daemon 以 bin/*_d 自动推导（后续 daemon
    # 增删不再改脚本）。socket 名约定 = daemon 名去 _d 后缀 + .sock。
    # minimal 画像仅保留核心执行链路（llm/think/agent/tool），其余跳过
    #（gateway 自动降级），以控制低内存设备占用（AIRYRT_PROFILE=minimal）。
    for _d in "$AIRY_HOME"/bin/*_d; do
        [ -f "$_d" ] || continue
        _b="${_d##*/}"
        case "$_b" in
            gateway_d|llm_d|think_d|agent_d|tool_d) continue ;;  # 独立处理
        esac
        [ "$AIRYRT_PROFILE" = "minimal" ] && continue
        [ -x "$_d" ] || continue
        _launch_daemon "$_d" "$RUNTIME_DIR/${_b%_d}.sock"
    done

    # ---- gateway_d：统一协议入口（HTTP/WS/HTTP2），与 daemon 群并行拉起 ----
    # 端口自适应：默认端口不可 bind（如残留半开连接占位）时自动探测 8083+
    # 可用端口，避免 "8080 被占 → gateway 起不来 → TUI 连不上" 的启动失败。
    # 探测必须与 gateway 实际 bind 行为对齐：加 SO_REUSEADDR，否则 TIME_WAIT
    # 残留（上个会话刚关闭的连接）会让裸 bind 探测误报"被占用"，导致端口
    # 每次启动都漂移（8080→8083），而 gateway（airy_sock_create_tcp_server
    # 设置 SO_REUSEADDR）实际能正常 bind 8080。
    _gw_port_available() { # <port>：探测端口是否可 bind（返回 0=可用）
        # 优先 python3（精确 SO_REUSEADDR bind 测试），回退 bash /dev/tcp
        # 连接探测（gateway 使用 SO_REUSEADDR，TIME_WAIT 不阻塞实际 bind）。
        if command -v python3 >/dev/null 2>&1; then
            python3 -c "import socket,sys; s=socket.socket(); s.setsockopt(socket.SOL_SOCKET, socket.SO_REUSEADDR, 1); s.bind(('127.0.0.1',int(sys.argv[1]))); s.close()" "$1" 2>/dev/null
        else
            # bash /dev/tcp：连接成功=有进程监听（端口被占），失败=可用
            (echo >/dev/tcp/127.0.0.1/"$1") 2>/dev/null && return 1
            return 0
        fi
    }
    GW_START="yes"   # 默认启动；gateway 已在线或探测到在线实例时置 no 复用
    if [ "$GATEWAY_ALIVE" = "1" ]; then
        GW_START="no"
        log info "gateway 已在线（$GATEWAY_URL），复用（生命周期不受本次会话管理）"
    else
        for _p in "$GATEWAY_PORT" $(seq 8083 8090); do
            if _gw_port_available "$_p"; then
                if [ "$_p" != "$GATEWAY_PORT" ]; then
                    log warn "端口 $GATEWAY_PORT 被占用（残留连接），gateway 改用端口 $_p"
                    GATEWAY_PORT="$_p"
                    GATEWAY_URL="http://127.0.0.1:${GATEWAY_PORT}"
                fi
                break
            fi
            # 端口不可 bind 但已有健康 gateway 在线 → 直接复用（避免重复拉起，
            # 此前缺陷：复用后仍无条件启动新实例，产生双 gateway 与进程泄漏）
            if wait_for_health "http://127.0.0.1:$_p" 1; then
                if [ "$_p" != "$GATEWAY_PORT" ]; then
                    log info "端口 $_p 已有在线 gateway，直接复用"
                    GATEWAY_PORT="$_p"
                    GATEWAY_URL="http://127.0.0.1:${GATEWAY_PORT}"
                fi
                GW_START="no"
                break
            fi
        done
    fi
    if [ "$GW_START" = "yes" ]; then
        log debug "执行: nohup \"$GATEWAY_BIN\" -h 127.0.0.1 -p \"$GATEWAY_PORT\" > \"$AIRY_HOME/logs/gateway_d.out\" 2>&1 &"
        nohup "$GATEWAY_BIN" -h 127.0.0.1 -p "$GATEWAY_PORT" >"$AIRY_HOME/logs/gateway_d.out" 2>&1 &
        GATEWAY_PID=$!
        log info "gateway_d 已拉起（PID=$GATEWAY_PID），日志: $AIRY_HOME/logs/gateway_d.out"
    else
        log info "gateway 复用在线实例（$GATEWAY_URL），本次会话不接管其生命周期"
    fi
    # 0.1.6h 修复：把实际 gateway 端口固化到运行时文件 run/gateway.port。
    # 根因：端口被占漂移到 8083+ 后，轻量启动器/TUI 仍硬编码 8080，
    # 导致"界面能进、网关拉不到/每次启动重复拉起"；统一从该文件读取。
    mkdir -p "$RUNTIME_DIR" 2>/dev/null || true
    printf '%s\n' "$GATEWAY_PORT" > "$RUNTIME_DIR/gateway.port" 2>/dev/null || true

    # ---- 统一等待全部 daemon socket 就绪（并行探测，0.25s 粒度）----
    wait_all_socks() {
        [ "${#WAIT_SOCKS[@]}" -eq 0 ] && return 0
        local deadline=$((SECONDS + 10)) spec name sock
        local remaining=() all_done
        while [ "${#WAIT_SOCKS[@]}" -gt 0 ] && [ "$SECONDS" -lt "$deadline" ]; do
            remaining=()
            all_done=1
            for spec in "${WAIT_SOCKS[@]}"; do
                name="${spec%%|*}"; sock="${spec#*|}"
                if _sock_alive "$sock"; then
                    log info "$name 就绪（$sock）"
                else
                    remaining+=("$spec")
                    all_done=0
                fi
            done
            WAIT_SOCKS=("${remaining[@]}")
            [ "$all_done" = "1" ] && return 0
            sleep 0.25
        done
        for spec in "${WAIT_SOCKS[@]}"; do
            name="${spec%%|*}"
            log warn "$name socket 未就绪，查看日志: $AIRY_HOME/logs/${name}.out"
        done
        return 1
    }
    WAIT_TOTAL="${#WAIT_SOCKS[@]}"   # 本次新拉起的 daemon 数（复用实例不在其中）
    # wait_all_socks 置于 if 条件：set -e 下直接调用返回非 0 会中止脚本，
    # 必须让调用方接管返回值才能走到诊断/降级分支。
    if wait_all_socks; then
        # 状态展示区分「复用」与「新拉」：此前仅显示新拉数，daemon 全在线
        # 复用时误显"就绪（0 个）"，用户误判系统未启动（2026-08-20 反馈）。
        if [ "$REUSED_COUNT" -gt 0 ] && [ "$WAIT_TOTAL" -gt 0 ]; then
            boot_line "守护进程群就绪（复用 ${REUSED_COUNT} 个 + 新拉 ${WAIT_TOTAL} 个）"
        elif [ "$REUSED_COUNT" -gt 0 ]; then
            boot_line "守护进程群就绪（在线 ${REUSED_COUNT} 个全部复用）"
        else
            boot_line "守护进程群就绪（${WAIT_TOTAL} 个）"
        fi
    else
        # 未就绪项逐项诊断（关键链路明确报错 + 日志尾部，非关键链路 WARN）
        diag_daemons
        boot_line "守护进程群部分未就绪（未就绪 ${#WAIT_SOCKS[@]} 个，详见上方诊断）"
    fi

    if wait_for_health "$GATEWAY_URL" 15; then
        log info "gateway 就绪（$GATEWAY_URL）"
        boot_line "gateway 就绪（$GATEWAY_URL）"
    else
        log warn "gateway 未能就绪（$GATEWAY_URL），查看日志: $AIRY_HOME/logs/gateway_d.out"
        boot_line "gateway 未就绪（$GATEWAY_URL），降级模式…"
        if [ -n "$CLI_BIN" ]; then
            # CLI 直连 daemon 群（Unix socket），不依赖 gateway HTTP：
            # gateway 起不来时降级到 CLI，而不是整站退出（用户痛点：多数
            # 场景仅对话/工具/任务，无需 gateway HTTP 协议入口）。
            GATEWAY_DOWN=1
            log warn "降级：使用 airy_cli 直连 daemon 群（不依赖 gateway）"
        else
            log error "TUI 依赖 gateway，但当前无 airy_cli 可降级"
            log error "可执行 'airymaxrt doctor' 检查组件，或删除 $RUNTIME_DIR 下残留 socket 后重试"
            exit 1
        fi
    fi
fi

# ── 前台进入交互界面（退出后由 EXIT trap 清理本次拉起的 daemons）──────────
# 智能双模由 launch_frontend 统一处理（有 TTY → Rust TUI；非 TTY → airy_cli 流式）。
launch_frontend
rc=$?
log info "交互界面退出（exit=$rc）"
exit $rc
