#
# airymaxrt — AirymaxRT 一键启动入口
#
# 在任意项目目录执行 `airymaxrt` 即可进入交互界面：
#   1. 定位组件（TUI / gateway_d / llm_d）
#   2. gateway 在线 → 直接进入 TUI；离线 → 自动拉起 llm_d + gateway_d
#   3. TUI 退出后清理本次拉起的守护进程（不影响已运行的外部 gateway）；
#      外部强杀（timeout/SIGTERM）同样经 trap 回收，不残留 daemon
#
# 安装（加入 PATH 即可）：
#   ln -s "$PWD/sdk/tui/scripts/airymaxrt" ~/bin/airymaxrt
#
# 日志（排查问题）：
#   - 终端：INFO/WARN/ERROR（彩色，带时间戳与级别）
#   - 文件：$AIRY_HOME/logs/airymaxrt.log（全量含 DEBUG，关键节点均有打点）
#   - 级别：AIRYRT_LOG_LEVEL=debug|info|warn|error（默认 info）
#
# 环境变量（均可覆盖默认值）：
#   AIRYRT_HOME       伞仓根（默认：脚本路径上溯自动推断）
#   AIRY_HOME         运行时根（默认 ~/.airymaxrt，等价 kubelet 节点运行时根）
#   AIRY_RUNTIME_DIR  运行时目录（默认 $AIRY_HOME/run，llm.sock 所在目录）
#   AIRY_GATEWAY_PORT gateway HTTP 端口（默认 8080）
#   AIRY_MODEL_CONFIG llm_d 模型配置（默认 $AIRYRT_HOME/ecosystem/manager/model/model.yaml）
#   AIRY_AGENT_FILE   Agent 定义文件（默认 agents/main.agent.yaml，相对当前目录）
#   AIRY_TUI_BIN / AIRY_GATEWAY_BIN / AIRY_LLM_BIN  组件路径覆盖
#   AIRYRT_LOG_LEVEL 日志级别（默认 info；debug 可看到完整排查信息）
#   AIRYRT_PROFILE   运行画像：auto（按可用内存自动裁剪，默认；<2.5GiB 时
#                     自动降为 minimal）| full（全量 18 daemon：17 socket +
#                     gateway）| minimal
#                     （最小 daemon 集，仅 llm/think/agent/tool + gateway）。
#                     低资源设备（如树莓派 4B 2GB）建议 minimal，可显著降低
#                     内存占用；非核心 daemon 未拉起时 gateway 自动降级。
#                     硬件变化（内存扩容/插入显卡）后执行 `airymaxrt profile`
#                     重新评估，或 `airymaxrt monitor --daemon` 后台常驻监控，
#                     检测到能力增强自动恢复被裁剪的 daemon（--stop 停止）。
#   AIRYRT_FORCE_TUI 强制 TUI 模式（跳过终端能力评估，默认自动评估：
#                     TERM=dumb/unknown 或屏幕 <20 行/<60 列时自动降级 CLI）。
#
# 组件缺失时：TUI 缺失报错退出；gateway_d/llm_d 缺失则以 OFFLINE 模式进入 TUI。

set -euo pipefail

# ── 定位伞仓根 ──────────────────────────────────────────────────────────────
# 解析符号链接得到脚本真实路径（支持 ~/bin/airymaxrt → 仓库 scripts/airymaxrt）
_SOURCE="${BASH_SOURCE[0]}"
while [ -L "$_SOURCE" ]; do
    _DIR="$(cd -P "$(dirname "$_SOURCE")" && pwd)"
    _SOURCE="$(readlink "$_SOURCE")"
    case "$_SOURCE" in
        /*) ;;
        *) _SOURCE="$_DIR/$_SOURCE" ;;
    esac
done
SCRIPT_DIR="$(cd -P "$(dirname "$_SOURCE")" && pwd)"
AIRYRT_HOME="${AIRYRT_HOME:-$(cd "$SCRIPT_DIR/../../.." && pwd)}"

# ── 配置 ─────────────────────────────────────────────────────────────────────
# AIRY_HOME 解析（路径统一，2026-08-28）：启动器自身所在安装根
# （$AIRY_HOME/bin/airymaxrt → ../config/install.env）→ 官方统一安装根
# ~/.airymaxrt。伞仓并列布局（<workspace>/.airymaxrt）与
# ~/.local/share/airymaxrt 历史候选移除——社区用户与本地开发同一逻辑。
# 环境变量残留防护：AIRY_HOME 指向不存在目录（终端残留 export / 半删除
# 安装）时告警并回退统一路径（历史故障：启动器 exec 已删除路径报 not
# found；Trae 持久终端的残留变量劫持安装与启动目标）。
if [ -n "${AIRY_HOME:-}" ] && [ ! -d "${AIRY_HOME}" ]; then
    printf '\033[1;33m[WARN]\033[0m AIRY_HOME=%s 不存在（疑似终端残留环境变量），已忽略并回退统一路径\n' "$AIRY_HOME" >&2
    AIRY_HOME=""
fi
if [ -z "${AIRY_HOME:-}" ]; then
    for _CAND in "${SCRIPT_DIR}/../config/install.env" \
                 "$HOME/.airymaxrt/config/install.env"; do
        if [ -f "$_CAND" ] && _HOME="$(sed -n 's/^AIRY_HOME=//p' "$_CAND" 2>/dev/null | head -1)"; then
            if [ -n "$_HOME" ]; then
                AIRY_HOME="$_HOME"
                break
            fi
        fi
    done
fi
AIRY_HOME="${AIRY_HOME:-$HOME/.airymaxrt}"
# 导出给子进程（TUI / airy_cli / daemon 群统一运行时根，避免默认 $HOME 分叉）
export AIRY_HOME
# 0.1.6c 系统性修复：AIRY_HOME 为权威运行根，RUNTIME_DIR 一律从最终
# AIRY_HOME 派生（父环境残留的旧 AIRY_RUNTIME_DIR 会使 socket 探测分叉）。
RUNTIME_DIR="${AIRY_HOME}/run"
GATEWAY_PORT="${AIRY_GATEWAY_PORT:-8080}"
GATEWAY_URL="http://127.0.0.1:${GATEWAY_PORT}"

# 模型配置优先取安装目录 $AIRY_HOME/config/model.yaml（install.sh/build.sh 已固化），
# 兼容旧源码树路径 $AIRYRT_HOME/ecosystem/manager/model/model.yaml。
if [ -f "${AIRY_MODEL_CONFIG:-$AIRY_HOME/config/model.yaml}" ]; then
    MODEL_CONFIG="${AIRY_MODEL_CONFIG:-$AIRY_HOME/config/model.yaml}"
else
    MODEL_CONFIG="${AIRY_MODEL_CONFIG:-$AIRYRT_HOME/ecosystem/manager/model/model.yaml}"
fi
AGENT_FILE="${AIRY_AGENT_FILE:-agents/main.agent.yaml}"

# ── 日志系统：debug 全量写文件，info+ 打印终端 ─────────────────────────────
LOG_FILE="$AIRY_HOME/logs/airymaxrt.log"
AIRYRT_LOG_LEVEL="${AIRYRT_LOG_LEVEL:-info}"
mkdir -p "$AIRY_HOME/logs" "$RUNTIME_DIR"
# set -e 防护：log 文件缺失时 touch 兜底，避免首次 log 写入失败中断脚本
#（logs 子命令在日志文件不存在时仍需正常输出错误提示）。
touch "$LOG_FILE" 2>/dev/null || true

_log_num() {
    case "$1" in
        debug) echo 0 ;;
        info)  echo 1 ;;
        warn)  echo 2 ;;
        error) echo 3 ;;
        *)     echo 1 ;;
    esac
}
LOG_LEVEL_NUM="$(_log_num "$AIRYRT_LOG_LEVEL")"

log() { # log <debug|info|warn|error> <消息...>
    local lvl="$1"
    shift
    [ "$(_log_num "$lvl")" -ge "$LOG_LEVEL_NUM" ] || return 0
    local line
    line="[$(date '+%Y-%m-%d %H:%M:%S')] [$(printf '%s' "$lvl" | tr '[:lower:]' '[:upper:]')] $*"
    # 终端日志统一走 stderr：避免被 $(cmd) 命令替换捕获（stdout 仅承载命令结果）。
    # 正常启动路径（AIRYRT_TERM_LOG=quiet）时 INFO 只写文件不进终端，
    # 让全屏 TUI 页面干净启动；status/doctor 子命令仍保留终端 INFO。
    if [ "${AIRYRT_TERM_LOG:-}" != "quiet" ] || [ "$lvl" != "info" ]; then
        case "$lvl" in
            info)  printf '\033[1;36m%s\033[0m\n' "$line" >&2 ;;
            warn)  printf '\033[1;33m%s\033[0m\n' "$line" >&2 ;;
            error) printf '\033[1;31m%s\033[0m\n' "$line" >&2 ;;
        esac
    fi
    printf '%s\n' "$line" >>"$LOG_FILE"
}

# ── PATH 自愈（2.3.2.6 增强，2026-08-24）──────────────────────────────
# 根因：默认 BIN_DIR=~/.local/bin 在多数新系统不在 PATH，旧安装器只提示
# 不自动修复 → 其他机器安装后输入 airymaxrt 报 command not found，只能
# 完整路径启动。此处兜底：以任意方式（含完整路径）启动时，若 BIN_DIR 软链
# 目录不在 PATH，自动幂等追加到当前 shell 的 rc 文件（带标记，卸载可移除）。
path_rc_file() {
    case "$(basename "${SHELL:-/bin/sh}")" in
        zsh) echo "$HOME/.zshrc" ;;
        fish) echo "$HOME/.config/fish/config.fish" ;;
        sh|dash|ash) echo "$HOME/.profile" ;;
        *) echo "$HOME/.bashrc" ;;
    esac
}
path_self_heal() {
    [ -f "$AIRY_HOME/config/install.env" ] || return 0
    local _binl _bind
    _binl="$(sed -n 's/^AIRY_BIN_LINK=//p' "$AIRY_HOME/config/install.env" 2>/dev/null | head -1)"
    _binl="${_binl:-$HOME/.local/bin/airymaxrt}"
    _bind="${_binl%/airymaxrt}"
    local _in_path=0 _p _seg
    _p="$PATH"
    while [ -n "$_p" ]; do
        _seg="${_p%%:*}"
        if [ "$_seg" = "$_bind" ]; then _in_path=1; break; fi
        if [ "$_seg" = "$_p" ]; then _p=""; else _p="${_p#*:}"; fi
    done
    [ "$_in_path" = "1" ] && return 0
    local _rc _line
    _rc="$(path_rc_file)"
    if grep -q '# >>> AgentRT PATH bootstrap <<<' "$_rc" 2>/dev/null; then
        log debug "PATH 自愈: $_rc 已含引导行，跳过"
        return 0
    fi
    if [ "$(basename "$_rc")" = "config.fish" ]; then
        _line="set -gx PATH \"${_bind}\" \$PATH"
    else
        _line="export PATH=\"${_bind}:\$PATH\""
    fi
    if printf '\n# >>> AgentRT PATH bootstrap <<<\n%s\n# <<< AgentRT PATH bootstrap <<<\n' "$_line" >> "$_rc" 2>/dev/null; then
        log warn "PATH 自愈: 已自动将 ${_bind} 追加到 $_rc（新开终端生效，或 source \"$_rc\"）"
    else
        log warn "PATH 自愈: 无法写入 $_rc——手动执行: echo '${_line}' >> \"$_rc\" && source \"$_rc\""
    fi
}

# ── 硬件评估（2.3.2：内存/核数/加速器综合画像，支持运行中监控恢复）────────
# assess_hardware 输出 `画像建议|MemTotal KiB|MemAvailable KiB|CPU 核数|加速器`
#   - minimal：MemTotal < 2.5GiB 或 MemAvailable < 1.5GiB 或 CPU 核数 < 3
#     （端侧/低配设备：树莓派 4B 2GB 等，避免全量 daemon 群 OOM）
#   - full：资源充足（大型服务器/个人电脑）
# 加速器探测（当前记录并随状态展示；为本地推理能力预留判定依据）：
#   - nvidia：nvidia-smi 可用（显卡数量）
#   - rocm：AMD ROCm 运行时可用
#   - dri：/dev/dri 渲染节点（Intel/AMD iGPU 或亮机卡）
#   - none：无可见加速器
# 架构检测（uname -m 归一化）：与 install.sh detect_arch 同口径（SSoT），
# 记录在画像中供 status 展示；install.sh 二进制模式以 {arch} 占位符
# 选择预编译包（见 agentrt/scripts/install.sh install_binary）。
detect_arch() {
    local _m _bits
    _m="$(uname -m 2>/dev/null)"
    # 与 install.sh detect_arch 同口径（SSoT）：uname -m 报内核架构，
    # 64 位内核 + 32 位用户空间（树莓派 armhf / 老 x86）误报 64 位且无对应
    # 加载器，装 64 位包后 daemon exec 全部失败（2026-08-30 树莓派实测）。
    # 以用户空间位数（getconf LONG_BIT）复判，三架构 32/64 位全覆盖。
    _bits="$(getconf LONG_BIT 2>/dev/null)"
    case "$_m" in
        x86_64|amd64)
            if [ "$_bits" = "64" ] || [ -f /lib64/ld-linux-x86-64.so.2 ]; then
                echo "x86_64"
            else
                echo "i686"
            fi
            ;;
        i386|i486|i586|i686|x86) echo "i686" ;;
        aarch64|arm64)
            if [ "$_bits" = "64" ] || [ -f /lib/ld-linux-aarch64.so.1 ]; then
                echo "aarch64"
            else
                echo "armv7l"
            fi
            ;;
        armv7l|armv6l|armhf) echo "armv7l" ;;
        riscv64)
            if [ "$_bits" = "64" ] || [ -f /lib/ld-linux-riscv64-lp64d.so.1 ]; then
                echo "riscv64"
            else
                echo "riscv32"
            fi
            ;;
        riscv32|riscv) echo "riscv32" ;;
        *)                echo "unknown" ;;
    esac
}
detect_accel() {
    if command -v nvidia-smi >/dev/null 2>&1 && nvidia-smi -L >/dev/null 2>&1; then
        echo "nvidia:$(nvidia-smi -L 2>/dev/null | wc -l)"
    elif command -v rocm-smi >/dev/null 2>&1; then
        echo "rocm"
    elif [ -d /dev/dri ] && ls /dev/dri/renderD* >/dev/null 2>&1; then
        echo "dri"
    else
        echo "none"
    fi
}

assess_hardware() {
    local mem_kib mem_avail_kib nproc_val accel profile
    mem_kib="$(awk '/^MemTotal:/{print $2}' /proc/meminfo 2>/dev/null || echo 0)"
    mem_avail_kib="$(awk '/^MemAvailable:/{print $2}' /proc/meminfo 2>/dev/null || echo "$mem_kib")"
    nproc_val="$(nproc 2>/dev/null || echo 1)"
    accel="$(detect_accel)"
    if [ -n "$mem_kib" ] && [ "$mem_kib" -gt 0 ] && \
       [ "$mem_kib" -ge $((2560 * 1024)) ] && \
       [ "$mem_avail_kib" -ge $((1536 * 1024)) ] && \
       [ "$nproc_val" -ge 3 ]; then
        profile="full"
    else
        profile="minimal"
    fi
    printf '%s|%s|%s|%s|%s' "$profile" "${mem_kib:-0}" "${mem_avail_kib:-0}" "$nproc_val" "$accel"
}

# 画像持久化：install.sh 固化 AIRY_PROFILE=minimal，但硬件变化（内存扩容/
# 外设接入）后 profile/profile 子命令的调整需跨会话生效——写入独立 profile.env
# 而非改动 install.env（安装信息保持只读），启动时 profile.env 优先。
PROFILE_ENV="$AIRY_HOME/config/profile.env"
if [ -f "$PROFILE_ENV" ]; then
    # shellcheck disable=SC1090
    . "$PROFILE_ENV"
fi

# ── 运行画像：full | minimal | auto（按硬件自动裁剪 daemon 集）────────
# auto 模式经 assess_hardware 综合判定（内存总量/可用内存/CPU 核数），
# 低资源设备自动降为 minimal（仅 llm/think/agent/tool + gateway），
# 其余能力 daemon 缺位时 gateway 自动降级，避免 2GB 设备 OOM。
# AIRYRT_PROFILE_RAW 记录解析前设置：monitor 据其区分「auto（可自动调整）」
# 与「显式 full/minimal（尊重用户选择，仅提示）」。
AIRYRT_PROFILE_RAW="${AIRYRT_PROFILE:-${AIRY_PROFILE:-auto}}"
AIRYRT_PROFILE="$AIRYRT_PROFILE_RAW"
case "$AIRYRT_PROFILE" in
    full|minimal|auto) ;;
    *) log error "无效的 AIRYRT_PROFILE='$AIRYRT_PROFILE'（支持 full|minimal|auto）"
       exit 2 ;;
esac
if [ "$AIRYRT_PROFILE" = "auto" ]; then
    _HW_ASSESS="$(assess_hardware)"
    AIRYRT_PROFILE="${_HW_ASSESS%%|*}"
    log info "硬件评估: 内存 ${_HW_ASSESS#*|}"
    log info "自动画像: $AIRYRT_PROFILE"
fi
log debug "AIRYRT_PROFILE=$AIRYRT_PROFILE"


# ── 启动进度行（2.1/2.2 启动体验优化） ─────────────────────────────────────
# quiet 模式（AIRYRT_TERM_LOG=quiet）下 INFO 不进终端，用户执行 airymaxrt
# 后等待 daemon 群拉起期间看到的是"黑屏无反馈"，感知为"系统不能正常启用"
# （2.1 用户反馈）。boot_line 在 quiet 下仍打印精简进度到 stderr：
#   - TUI 路径：进入全屏（alt-screen）后这些行被清屏覆盖，不残留
#   - CLI 流式路径：stdout 承载对话结果，stderr 进度不影响结果解析
# 每行以 `›` 引导、无时间戳（非日志，是进度），warn/error 走 log 通道。
boot_line() { # <消息...>
    printf '\033[2m›\033[0m %s\n' "$*" >&2
}

# ── 关键 daemon 就绪诊断（2.2 启动可靠性优化） ─────────────────────────────
# daemon 群 socket 未全部就绪时汇总诊断：对话/工具/认知关键链路（llm/think/
# agent/tool）未就绪必须明确报错（附日志尾部摘要）；非关键链路降级 WARN
#（界面可用但该能力受限）。0.1.6h 精简：16 个未就绪时由 50+ 行收敛为
# 汇总 4~6 行，过滤 nohup 噪音行，避免视觉轰炸。
diag_daemons() { # 遍历剩余 WAIT_SOCKS（未就绪项）
    local spec name sock critical="" degraded=""
    for spec in "${WAIT_SOCKS[@]}"; do
        name="${spec%%|*}"; sock="${spec#*|}"
        case "$name" in
            llm_d|think_d|agent_d|tool_d)
                critical="${critical:+$critical }$name"
                ;;
            *)
                degraded="${degraded:+$degraded }$name"
                ;;
        esac
    done
    if [ -n "$degraded" ]; then
        log warn "能力 daemon 未就绪（界面可用，能力受限）: ${degraded}；日志: $AIRY_HOME/logs/*.out"
    fi
    if [ -n "$critical" ]; then
        log error "关键 daemon 未就绪: ${critical}（对话/认知/执行链路必需）"
        local _lines _l
        for name in $critical; do
            _lines="$(tail -n 3 "$AIRY_HOME/logs/${name}.out" 2>/dev/null | grep -v 'nohup: ignoring input' | tr '\n' ' ' | sed 's/  */ /g')" || true
            [ -n "$_lines" ] && log error "  ${name}: ${_lines}"
        done
        log error "处理: 'airymaxrt doctor' 检查组件，或删除 $RUNTIME_DIR 残留 socket 后重试"
    fi
}

# ── 密钥加载：secrets.env（set -a 自动 export 给子进程）───────────────────
# 权威单一来源：$AIRY_HOME/config/secrets.env（install.sh init_secrets 生成）。
# 历史多候选（$AIRYRT_HOME/.airymaxrt、$PWD/.airymaxrt）按路径统一原则移除
# （2026-08-28）；$PWD 候选还构成在不可信目录加载密钥的供应链风险。
_SECRET_FILE="$AIRY_HOME/config/secrets.env"
if [ -f "$_SECRET_FILE" ]; then
    log info "加载密钥文件: $_SECRET_FILE"
    set -a
    # shellcheck disable=SC1090
    . "$_SECRET_FILE"
    set +a
fi

log debug "==== airymaxrt 启动 ===="
log debug "配置: AIRYRT_HOME=$AIRYRT_HOME AIRY_HOME=$AIRY_HOME RUNTIME_DIR=$RUNTIME_DIR"
log debug "配置: GATEWAY_URL=$GATEWAY_URL MODEL_CONFIG=$MODEL_CONFIG AGENT_FILE=$AGENT_FILE"

# ── 运行环境注入：agentrt-env.sh（build.sh 生成，含 AIRY_AGENT_ACL 等）──────
# daemon 群与前端统一继承该环境；不 source 时 daemon 以 fail-closed 运行，
# agent 工具全部被 ACL 拒绝（历史故障：airymaxrt 拉起的 agent_d 无 ACL，
# 任务执行阶段 shell_run/fs_* 全部 Permission denied）。
# 注意：历史版本 agentrt-env.sh 以 `export AIRY_HOME=安装值` 硬编码覆盖
# 调用方显式设置（隔离测试/多实例/--prefix 自定义安装），导致 daemon 群
# 与脚本等待探测的 socket 目录分叉——socket 永远"未就绪"、第二实例 unlink
# 生产 socket 造成服务假死（2026-08-20 冷启动复现）。AIRY_HOME 权威值以
# 脚本解析为准（install.env 固化），source 后强制恢复，RUNTIME_DIR 同源重算。
if [ -f "$AIRY_HOME/bin/agentrt-env.sh" ]; then
    log debug "注入运行环境: $AIRY_HOME/bin/agentrt-env.sh"
    _AIRY_HOME_RESOLVED="$AIRY_HOME"
    # shellcheck disable=SC1090
    . "$AIRY_HOME/bin/agentrt-env.sh"
    AIRY_HOME="$_AIRY_HOME_RESOLVED"
    export AIRY_HOME
    RUNTIME_DIR="${AIRY_HOME}/run"
    log debug "agentrt-env.sh 注入后恢复 AIRY_HOME=$AIRY_HOME RUNTIME_DIR=$RUNTIME_DIR"
fi

# ── 运行库路径兜底（0.1.6c 系统性修复）─────────────────────────────────────
# 包内 lib/ 自带全部第三方 .so（curl/gnutls/ssh/ssl1.1 等传递依赖），但
# DT_RUNPATH 非传递性——daemon 的直接依赖可经 $ORIGIN/../lib 找到，而
# libcurl 等的传递依赖只能走系统路径或 LD_LIBRARY_PATH。老用户（0.1.5a
# 及更早安装）的 agentrt-env.sh 无 LD_LIBRARY_PATH 注入行，且 airymaxrt
# update 的热替换不重新生成 env.sh → daemon 群"很多库找不到"起不来
# （Ubuntu 24.04 无 libssl.so.1.1 等）。此处幂等兜底：无论 env.sh 版本
# 如何，确保 $AIRY_HOME/lib 始终在 LD_LIBRARY_PATH 首位（已含则跳过），
# 覆盖 daemon 群 + CLI + TUI 全部子进程。bootstrap.sh 侧已有同源兜底。
case ":${LD_LIBRARY_PATH:-}:" in
    *":$AIRY_HOME/lib:"*) ;;
    *) export LD_LIBRARY_PATH="$AIRY_HOME/lib:${LD_LIBRARY_PATH:-}" ;;
esac

# ── 系统 curl 隔离调用（0.1.6f 根治 LD_LIBRARY_PATH 劫持）───────────────
# 全局 LD_LIBRARY_PATH 注入 $AIRY_HOME/lib 让 daemon 群解析包内 .so；
# 但同一注入会劫持系统 curl：Debian/Ubuntu 新版 curl 依赖
# curl_easy_ssls_import 等符号，而包内旧 libcurl.so.4 无此符号 → 立即
# 崩溃（树莓派社区用户实测 curl: undefined symbol）。下载/更新/探测
# 类网络操作必须经 syscurl()：临时剔除 $AIRY_HOME/lib 后调用系统
# libcurl，与 daemon 进程空间彻底隔离。
syscurl() {
    local ldp="" p
    local IFS=:
    for p in ${LD_LIBRARY_PATH:-}; do
        [ "$p" = "$AIRY_HOME/lib" ] && continue
        ldp="${ldp:+$ldp:}$p"
    done
    if [ -n "$ldp" ]; then
        env LD_LIBRARY_PATH="$ldp" curl "$@"
    else
        env -u LD_LIBRARY_PATH curl "$@"
    fi
}

# 跨平台原地编辑（0.1.6g）：GNU sed（-i expr）与 BSD sed（-i '' expr）
# 语法不同，直接 sed -i 在 macOS 上 "illegal option" 静默失败（profile.env
# / install.env 键更新失效且可能产生重复行）。统一 临时文件 + mv（POSIX）。
sed_inplace() { # <sed-expr> <file>
    local _se="$1" _f="$2" _t="${2}.tmp.$$"
    if sed "$_se" "$_f" > "$_t" 2>/dev/null; then
        mv "$_t" "$_f"
    else
        rm -f "$_t"
        return 1
    fi
}

# ── 组件定位 ─────────────────────────────────────────────────────────────────
# find_tool <env_name> <command_name> <候选路径...>
#   优先显式环境变量，其次伞仓内构建产物，最后 PATH 中的命令。
find_tool() {
    local env_name="$1" cmd_name="$2"
    shift 2
    if [ -n "${!env_name:-}" ]; then
        log debug "$env_name 环境变量覆盖: ${!env_name}"
        if [ -x "${!env_name}" ]; then
            echo "${!env_name}"
            return
        fi
        log warn "$env_name 指向的路径不可执行: ${!env_name}"
    fi
    local c
    for c in "$@"; do
        if [ -x "$c" ]; then
            log debug "找到 $cmd_name: $c"
            echo "$c"
            return
        fi
        log debug "候选不存在: $c"
    done
    local from_path
    if from_path="$(command -v "$cmd_name" 2>/dev/null)"; then
        log debug "PATH 中找到 $cmd_name: $from_path"
        echo "$from_path"
    else
        log warn "未找到 $cmd_name（PATH 与候选路径均无）"
    fi
}

