# ── 等待辅助（每轮打点，便于排查就绪时序） ─────────────────────────────────
# gateway 无 /health HTTP 端点，就绪检测使用 JSON-RPC ping（HTTP POST）。
wait_for_health() { # <url> <秒数>
    local url="$1" tries="$2" i
    log debug "健康检查开始: $url（最多 ${tries}s）"
    for ((i = 0; i < tries; i++)); do
        if syscurl -fsS -m 1 -X POST -H 'Content-Type: application/json' \
            -d '{"jsonrpc":"2.0","method":"ping","id":1}' "$url" >/dev/null 2>&1; then
            log debug "健康检查通过: $url（第 $((i + 1)) 次尝试）"
            return 0
        fi
        log debug "健康检查未就绪: $url（第 $((i + 1)) 次尝试）"
        sleep 1
    done
    log debug "健康检查超时: $url"
    return 1
}

# _sock_alive <socket路径>：真实服务探测（0=daemon 在监听并响应，可复用）。
# 仅查文件存在（-S）不可靠：崩溃/重复拉起后可能残留无监听者的
# 死 socket（stale），此时 connect 返回 ECONNREFUSED。
# 更隐蔽的场景（2026-08-19）：daemon 被强杀后，其 agent runner 子进程
# 仍持有继承的监听 fd，connect 可以成功但无人 accept/响应——仅做
# connect 探测会误判在线而复用死 daemon，表现为界面能进、任务挂起
# （health_check recv 超时）。因此连接成功后追加一次 health_check
# JSON-RPC 往返：1.5s 内收到响应才算在线。
# 探测工具优先级：python3 > nc（Unix socket）> ss -l（Linux，仅连通）。
_sock_alive() { # <socket路径>
    local path="$1"
    [ -S "$path" ] || return 1
    if command -v python3 >/dev/null 2>&1; then
        python3 -c "import socket,sys; s=socket.socket(socket.AF_UNIX); s.settimeout(1.5); s.connect(sys.argv[1]); s.sendall(b'{\"jsonrpc\":\"2.0\",\"method\":\"health_check\",\"params\":{},\"id\":1}\n'); s.recv(1)" "$path" 2>/dev/null
    elif command -v nc >/dev/null 2>&1; then
        nc -zU "$path" 2>/dev/null
    elif command -v ss >/dev/null 2>&1; then
        # ss -lx 列出 Unix domain socket（-lntu 是 TCP/UDP，不匹配）。
        # 无 python3/nc 的回退仅验证「有监听者」，无法区分孤儿 socket。
        ss -lx 2>/dev/null | grep -qF "$path" 2>/dev/null
    else
        # 最终回退：bash 内置 /dev/unix 路径不可用，用 curl 探测
        # gateway JSON-RPC（仅适用于 gateway.sock）。通用场景返回 1
        # 由调用方按 stale socket 处理。
        return 1
    fi
}

# ── 硬件监控补齐（2.3.2：monitor/profile 共用）────────────────────────────
# _ensure_daemon <bin路径> <socket路径>：socket 未就绪则独立后台拉起。
# 与 _launch_daemon 的差异：不绑定本次会话生命周期（会话退出不回收）——
# 由后续 airymaxrt 会话的复用探测（_sock_alive）接管管理，适合常驻补齐。
_ensure_daemon() {
    local bin="$1" sock="$2" bname
    [ -x "$bin" ] || return 0
    bname="${bin##*/}"
    if _sock_alive "$sock"; then
        log debug "补齐跳过: $bname 已在运行（$sock）"
        return 0
    fi
    if [ -S "$sock" ]; then
        log warn "$bname stale socket（无监听），移除后补齐: $sock"
        rm -f "$sock"
    fi
    nohup "$bin" >"$AIRY_HOME/logs/${bname}.out" 2>&1 &
    log info "补齐 daemon: $bname（PID=$!），日志: $AIRY_HOME/logs/${bname}.out"
}

